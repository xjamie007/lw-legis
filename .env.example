# ---------------------------------------------------------------------------
# LW LEGIS — Umgebungsvariablen
# Diese Datei ist eine Vorlage. Kopieren nach `.env` und ausfuellen.
# `.env` steht in .gitignore und darf NIEMALS committet werden.
# ---------------------------------------------------------------------------

# Oeffentliche Adresse der Seite (ohne abschliessenden Schraegstrich)
PUBLIC_SITE_URL=https://www.lw-legis.lu

# --- Supabase -------------------------------------------------------------
# Projekt-URL und der oeffentliche "anon"-Schluessel. Beide sind fuer den
# Browser bestimmt und duerfen im Frontend stehen; geschuetzt wird der
# Zugriff ausschliesslich durch Row Level Security in der Datenbank.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Der Service-Role-Schluessel umgeht RLS. Er wird NUR beim Build auf dem
# Server (GitHub Actions) benutzt, steht dort als Repository-Secret und
# taucht niemals im ausgelieferten HTML oder JavaScript auf.
SUPABASE_SERVICE_ROLE_KEY=

# --- Formularversand (Edge Function `send-inquiry`) -----------------------
# Diese Werte werden als Supabase-Function-Secrets gesetzt, nicht hier.
# Siehe README, Abschnitt "Formular in Betrieb nehmen".
# INQUIRY_RECIPIENT=contact@cabinet-avocats-lorang.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Veroeffentlichen (Edge Function `publish`) ---------------------------
# Fein granuliertes GitHub-Token mit Recht "Contents: read & write" auf das
# Website-Repository, fuer repository_dispatch.
# GITHUB_DISPATCH_TOKEN=
# GITHUB_REPOSITORY=nave-lu/lw-legis
