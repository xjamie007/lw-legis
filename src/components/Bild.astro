---
/**
 * src/components/Bild.astro — Ein Bild aus content/source/bilder.mjs.
 *
 * Ein <picture> mit AVIF, WebP und dem Original, `srcset` ueber die
 * erzeugten Breiten, `width` und `height` im Markup (damit beim Laden
 * nichts springt) und dem Bildausschnitt aus dem Redaktionsbereich.
 * Fehlt die Datei, wird nichts ausgegeben: eine Kanzleiseite zeigt lieber
 * kein Bild als einen Platzhalter.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { contenu } from '../lib/content';
import { prefixer } from '../lib/base';

interface Props {
  /** Schluessel aus content/source/bilder.mjs */
  platz: string;
  lang: Lang;
  /** Breiten-Hinweis fuer den Browser, z. B. '(min-width: 62rem) 22rem, 100vw' */
  sizes?: string;
  /** Ueber der Falz? Dann nicht faul laden. */
  eifrig?: boolean;
  class?: string;
}

const { platz, lang, sizes = '100vw', eifrig = false, class: klass } = Astro.props;

const bild = contenu.bilder?.[platz];
const breiten: number[] = bild?.breiten ?? [480, 768, 1200, 1800];
const basis = bild?.datei ? prefixer(String(bild.datei).replace(/\.[^.]+$/, '')) : '';
const endung = bild?.datei ? (String(bild.datei).match(/\.[^.]+$/)?.[0] ?? '.jpg') : '.jpg';
const srcset = (format: string) => breiten.map((b) => `${basis}-${b}.${format} ${b}w`).join(', ');

const [rw, rh] = String(bild?.seitenverhaeltnis ?? '3 / 2')
  .split('/')
  .map((n) => Number(n.trim()));
const breite = breiten.at(-1) ?? 1200;
const hoehe = Math.round((breite / rw) * rh);
---

{
  bild?.datei && (
    <picture class={klass}>
      <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
      <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
      <img
        src={`${basis}${endung}`}
        alt={txt(bild.alt, lang)}
        width={breite}
        height={hoehe}
        loading={eifrig ? 'eager' : 'lazy'}
        decoding={eifrig ? 'sync' : 'async'}
        fetchpriority={eifrig ? 'high' : undefined}
        style={`object-position: ${bild.point_x ?? 50}% ${bild.point_y ?? 50}%`}
      />
    </picture>
  )
}
