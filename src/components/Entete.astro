---
/**
 * src/components/Entete.astro — Kopfbereich.
 *
 * Aufbau: Wortmarke — Navigation — Sprachen — Telefonnummer.
 *
 * Ohne JavaScript vollstaendig bedienbar. Das Menue am Handy ist ein
 * <details>-Element; der Sprachumschalter besteht aus vier gewoehnlichen
 * Links, weil vier Sprachen keine Aufklappliste brauchen.
 *
 * Der Sprachumschalter bleibt auf derselben Seite und wirft niemanden auf
 * die Startseite zurueck: `alternatifs` liefert je Sprache den Pfad
 * genau dieser Seite.
 */
import { LANGS, LANG_NOMS, LANG_BALISE, type Lang } from '../lib/langs';
import { t, type Cle } from '../lib/i18n';
import { contenu, languesDuSite } from '../lib/content';
import { seg, urlAccueil, type NomSegment } from '../lib/routes';
import Wappen from './Wappen.astro';

interface Props {
  lang: Lang;
  chemin: string;
  alternatifs?: (l: Lang) => string | null;
}

const { lang, chemin, alternatifs } = Astro.props;

const pretes = languesDuSite();

const liens = contenu.navigation
  .filter((n) => n.visible)
  .sort((a, b) => a.ordre - b.ordre)
  .map((n) => ({
    cle: n.cle as Cle,
    href: (() => {
      const s = seg(n.segment as NomSegment, lang);
      return s ? `/${lang}/${s}/` : null;
    })(),
  }))
  .filter((n): n is { cle: Cle; href: string } => n.href !== null);

const tel = contenu.settings.telephone;

/** Fuer jede Sprache: Adresse dieser Seite, oder null. */
const langues = LANGS.map((l) => {
  const disponible = pretes.includes(l);
  const href = disponible ? (alternatifs?.(l) ?? urlAccueil(l)) : null;
  return { lang: l, nom: LANG_NOMS[l], code: LANG_BALISE[l], href, disponible };
});

/** Ist dieser Navigationspunkt der aktuelle? */
const actif = (href: string) => chemin.startsWith(href);

/** Nur auf der Startseite zeichnet sich das Wappen einmal selbst. */
const estAccueil = chemin === urlAccueil(lang);
---

<header class="entete sans-impression">
  <div class="entete__barre enveloppe">
    <a class="marque" href={urlAccueil(lang)}>
      {/* Das Wappen trägt den Namen der Kanzlei bereits in sich. Eine
          zweite Wortmarke daneben wäre dieselbe Aussage zweimal. */}
      <Wappen groesse="klein" auftritt={estAccueil} alt={`${contenu.settings.nom} — ${t(lang, 'nav.accueil')}`} />
    </a>

    <nav class="entete__nav" aria-label={t(lang, 'nav.principale')}>
      <ul class="liens">
        {
          liens.map((l) => (
            <li>
              <a
                href={l.href}
                class:list={['liens__lien', { 'liens__lien--actif': actif(l.href) }]}
                aria-current={actif(l.href) ? 'page' : undefined}
              >
                {t(lang, l.cle)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="entete__cote">
      <nav class="langues" aria-label={t(lang, 'nav.choisir_langue')}>
        <ul class="langues__liste">
          {
            langues.map((l) =>
              l.disponible && l.href ? (
                <li>
                  <a
                    href={l.href}
                    class:list={['langues__lien', { 'langues__lien--actif': l.lang === lang }]}
                    lang={l.code}
                    hreflang={l.code}
                    aria-current={l.lang === lang ? 'true' : undefined}
                  >
                    <abbr title={l.nom}>{l.code.toUpperCase()}</abbr>
                  </a>
                </li>
              ) : (
                <li>
                  <span class="langues__absent" lang={l.code}>
                    <abbr title={`${l.nom} — ${t(lang, 'nav.langue_en_preparation')}`}>
                      {l.code.toUpperCase()}
                    </abbr>
                  </span>
                </li>
              ),
            )
          }
        </ul>
      </nav>

      <a class="telephone" href={`tel:${tel.central_lien}`} aria-label={t(lang, 'nav.telephoner')}>
        {tel.central}
      </a>
    </div>

    <details class="menu">
      <summary class="menu__bouton">
        <span class="menu__texte">{t(lang, 'nav.menu')}</span>
        <span class="menu__barres" aria-hidden="true"></span>
      </summary>
      <div class="menu__panneau">
        <nav aria-label={t(lang, 'nav.principale')}>
          <ul class="menu__liens">
            {
              liens.map((l) => (
                <li>
                  <a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>
                    {t(lang, l.cle)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {/* Die Sprachwahl gehoert auch ins Menue am Handy. Ohne sie waere
            auf dem Telefon keine Sprache zu wechseln — bei einer
            viersprachigen Seite fuer Auslaender der schwerste denkbare
            Bedienfehler. */}
        <nav class="menu__langues" aria-label={t(lang, 'nav.choisir_langue')}>
          <p class="menu__langues-titre">{t(lang, 'nav.langue')}</p>
          <ul class="menu__langues-liste">
            {langues.map((l) =>
              l.disponible && l.href ? (
                <li>
                  <a
                    href={l.href}
                    class:list={['menu__langue', { 'menu__langue--actif': l.lang === lang }]}
                    lang={l.code}
                    hreflang={l.code}
                    aria-current={l.lang === lang ? 'true' : undefined}
                  >
                    {l.nom}
                  </a>
                </li>
              ) : (
                <li>
                  <span class="menu__langue menu__langue--absent" lang={l.code}>
                    {l.nom} — {t(lang, 'nav.langue_en_preparation')}
                  </span>
                </li>
              ),
            )}
          </ul>
        </nav>

        <a class="menu__telephone" href={`tel:${tel.central_lien}`}>
          {tel.central}
        </a>
      </div>
    </details>
  </div>
</header>

<style>
  .entete {
    background-color: var(--color-papier);
    border-bottom: 1px solid color-mix(in srgb, var(--color-pierre) 22%, transparent);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* Die Kopfzeile ist nicht auf die Lesespalte gedeckelt: Sie läuft über
     die volle Breite, mit demselben linken Rand wie der Seiteninhalt. Die
     Telefonnummer steht damit ganz rechts — so wie in der Entwurfsskizze.

     Vorher lag sie in `.enveloppe` und war auf 64 rem begrenzt. Auf
     Deutsch braucht sie rund 1160 Pixel; bei 1200 Pixeln Fensterbreite
     ragte sie deshalb 17 Pixel aus dem Bild. */
  .entete__barre {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 4.25rem;
    padding-block: 0.75rem;
    max-width: none;
    margin-inline: 0;
    padding-inline: var(--bord-gauche) var(--gouttiere);
  }

  /* --- Wortmarke ---------------------------------------------------------- */
  .marque {
    text-decoration: none;
    color: var(--color-encre);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-right: auto;
  }
  .marque:hover {
    color: var(--color-encre);
  }
  .marque__nom {
    display: block;
    /* Die Wortmarke bricht nie um. Auf Deutsch ist die Navigation
       laenger, und ohne das hier stuende dort "LW / LEGIS". */
    white-space: nowrap;
    font-family: var(--font-lecture);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: 0.06em;
    line-height: 1.1;
  }
  .marque__sous {
    display: none;
    font-family: var(--font-commande);
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--color-pierre);
    margin-top: 0.15rem;
  }

  /* --- Hauptnavigation ---------------------------------------------------- */
  .entete__nav {
    display: none;
  }
  .liens {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .liens__lien {
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    letter-spacing: 0.01em;
    color: var(--color-encre);
    text-decoration: none;
    padding-block: 0.6rem;
    display: inline-block;
    border-bottom: 1.5px solid transparent;
  }
  .liens__lien:hover {
    color: var(--color-frontiere-tief);
    border-bottom-color: var(--color-laiton);
  }
  .liens__lien--actif {
    border-bottom-color: var(--color-laiton);
    color: var(--color-frontiere-tief);
  }

  /* --- Sprachen und Telefon ------------------------------------------------ */
  .entete__cote {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }
  .langues__liste {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .langues__lien,
  .langues__absent {
    font-family: var(--font-commande);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    min-height: 1.75rem;
    padding: 0.25rem;
    border-radius: var(--radius-commande);
  }
  .langues__lien {
    color: var(--color-pierre);
    text-decoration: none;
  }
  .langues__lien:hover {
    color: var(--color-frontiere-tief);
  }
  .langues__lien--actif {
    color: var(--color-encre);
    border-bottom: 1.5px solid var(--color-laiton);
  }
  .langues__absent {
    /* Die Sprache wird genannt, aber nicht verlinkt: es gibt sie noch
       nicht. Ein toter Link waere schlechter als diese Ehrlichkeit. */
    color: color-mix(in srgb, var(--color-pierre) 60%, var(--color-papier));
    cursor: help;
  }
  .langues__lien abbr,
  .langues__absent abbr {
    text-decoration: none;
    border: 0;
  }

  .telephone {
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    color: var(--color-frontiere);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.5rem;
  }
  .telephone:hover {
    color: var(--color-frontiere-tief);
    text-decoration: underline;
  }

  /* --- Menue am Handy ------------------------------------------------------
     Ein <details>-Element: funktioniert ohne eine Zeile JavaScript,
     inklusive Tastaturbedienung und aria-expanded, das der Browser selbst
     auf dem <summary> fuehrt.
     ---------------------------------------------------------------------- */
  .menu {
    margin-left: auto;
  }
  .menu__bouton {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.25rem 0.5rem 0.75rem;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    color: var(--color-encre);
    cursor: pointer;
    list-style: none;
  }
  .menu__bouton::-webkit-details-marker {
    display: none;
  }
  .menu__barres {
    position: relative;
    width: 1.25rem;
    height: 0.75rem;
    flex: none;
  }
  .menu__barres::before,
  .menu__barres::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background-color: var(--color-laiton-texte);
    transition: transform 160ms ease-out;
  }
  .menu__barres::before {
    top: 0.0625rem;
  }
  .menu__barres::after {
    bottom: 0.0625rem;
  }
  .menu[open] .menu__barres::before {
    transform: translateY(0.3125rem) rotate(45deg);
  }
  .menu[open] .menu__barres::after {
    transform: translateY(-0.3125rem) rotate(-45deg);
  }

  .menu__panneau {
    position: absolute;
    left: 0;
    right: 0;
    background-color: var(--color-papier);
    border-bottom: var(--trait);
    padding: 0.5rem var(--gouttiere) 1.5rem;
    box-shadow: none;
  }
  .menu__liens {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu__liens a {
    display: block;
    padding-block: 0.85rem;
    font-family: var(--font-commande);
    font-size: 1.0625rem;
    color: var(--color-encre);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-pierre) 18%, transparent);
  }
  .menu__liens a[aria-current='page'] {
    color: var(--color-frontiere-tief);
  }
  .menu__langues {
    margin-top: 1.5rem;
  }
  .menu__langues-titre {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-pierre);
    margin-bottom: 0.4rem;
  }
  .menu__langues-liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .menu__langue {
    display: inline-block;
    min-height: 2.75rem;
    padding-block: 0.7rem;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    color: var(--color-frontiere);
    text-decoration: none;
  }
  .menu__langue--actif {
    color: var(--color-encre);
    border-bottom: 1.5px solid var(--color-laiton);
  }
  .menu__langue--absent {
    color: var(--color-pierre);
  }

  .menu__telephone {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-commande);
    font-size: 1.0625rem;
    color: var(--color-frontiere);
  }

  /* --- Ab grossem Schirm: alles offen, kein Menueknopf ---------------------
     Die Schwelle liegt bei 78rem und nicht bei 62rem: Auf Deutsch heissen
     die Punkte „Taetigkeitsgebiete" und „Die Kanzlei", und bei 1000 Pixeln
     brach die Zeile um, die Wortmarke schob sich in die Navigation und die
     Telefonnummer lief aus dem Bild. Dazwischen ist das Menue die
     ehrlichere Loesung. */
  @media (min-width: 78rem) {
    .menu {
      display: none;
    }
    .entete__nav,
    .entete__cote {
      display: flex;
    }
    .marque__sous {
      display: block;
    }
    .entete__barre {
      gap: 2rem;
    }
  }
</style>
