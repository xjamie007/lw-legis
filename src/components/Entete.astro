---
/**
 * src/components/Entete.astro — Kopfbereich.
 *
 * Oben eine schmale marineblaue Leiste mit Adresse, Telefon, E-Mail und
 * Sprachwahl, darunter die weisse Kopfzeile mit Wappen und Menue. Auf dem
 * Handy klappt das Menue als ganze Flaeche auf; ohne JavaScript bleibt es
 * eine einfache Liste unter dem Wappen.
 */
import type { Lang } from '../lib/langs';
import { LANG_NOMS } from '../lib/langs';
import { t, type Cle } from '../lib/i18n';
import { contenu, languesDuSite } from '../lib/content';
import { seg, urlAccueil, type NomSegment } from '../lib/routes';
import { prefixer } from '../lib/base';
import Icone from './Icone.astro';

interface Props {
  lang: Lang;
  chemin: string;
  alternatifs?: (l: Lang) => string | null;
}
const { lang, chemin, alternatifs } = Astro.props;
const s = contenu.settings;

const liens = contenu.navigation
  .filter((n) => n.visible)
  .sort((a, b) => a.ordre - b.ordre)
  .map((n) => {
    const x = seg(n.segment as NomSegment, lang);
    return x ? { cle: n.cle as Cle, href: prefixer(`/${lang}/${x}/`) } : null;
  })
  .filter((l): l is { cle: Cle; href: string } => l !== null);

const actif = (href: string) => chemin === href || chemin.startsWith(href);

const langues = languesDuSite().map((l) => ({
  lang: l,
  href: alternatifs?.(l) ?? urlAccueil(l),
  courant: l === lang,
}));
---

<header class="entete">
  <div class="barre">
    <div class="enveloppe barre__interieur">
      <p class="barre__adresse">{s.adresse.une_ligne}</p>
      <div class="barre__droite">
        <a href={`tel:${s.telephone.lien}`}><Icone nom="telephone" />{s.telephone.affiche}</a>
        <a href={`mailto:${s.courriel}`} class="barre__courriel"><Icone nom="courriel" />{s.courriel}</a>
        <ul class="langues" aria-label={t(lang, 'nav.langue')}>
          {
            langues.map((l) => (
              <li>
                {l.courant ? (
                  <span aria-current="true" title={LANG_NOMS[l.lang]}>
                    {l.lang.toUpperCase()}
                  </span>
                ) : (
                  <a href={l.href} hreflang={l.lang} lang={l.lang} title={LANG_NOMS[l.lang]}>
                    {l.lang.toUpperCase()}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="tete-site">
    <div class="enveloppe tete-site__interieur">
      <a class="marque" href={urlAccueil(lang)} aria-label={`${s.nom} — ${t(lang, 'nav.accueil')}`}>
        <img src={prefixer('/bilder/wappen.png')} alt="" width="694" height="240" />
      </a>

      <button
        class="menu-bouton"
        type="button"
        aria-expanded="false"
        aria-controls="menu"
        data-menu-bouton
        data-ouvrir={t(lang, 'nav.menu_ouvrir')}
        data-fermer={t(lang, 'nav.menu_fermer')}
        aria-label={t(lang, 'nav.menu_ouvrir')}
      >
        <Icone nom="menu" class="menu-bouton__ouvrir" />
        <Icone nom="fermer" class="menu-bouton__fermer" />
        <span>{t(lang, 'nav.menu')}</span>
      </button>

      <nav class="menu" id="menu" aria-label={t(lang, 'nav.principale')} data-menu>
        <ul>
          {
            liens.map((l) => (
              <li>
                <a href={l.href} aria-current={actif(l.href) ? 'page' : undefined}>
                  {t(lang, l.cle)}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="menu__pied">
          <a href={`tel:${s.telephone.lien}`}>{s.telephone.affiche}</a>
          <a href={`mailto:${s.courriel}`}>{s.courriel}</a>
          <p>{s.adresse.une_ligne}</p>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const bouton = document.querySelector<HTMLButtonElement>('[data-menu-bouton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (bouton && menu) {
    const basculer = (ouvert: boolean) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      bouton.setAttribute('aria-label', (ouvert ? bouton.dataset.fermer : bouton.dataset.ouvrir) ?? '');
      document.documentElement.classList.toggle('menu-ouvert', ouvert);
    };
    bouton.addEventListener('click', () => basculer(bouton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
        basculer(false);
        bouton.focus();
      }
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', () => basculer(false));
  }
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* --- Leiste ------------------------------------------------------------ */
  .barre {
    background: var(--color-marine-tief);
    color: var(--color-marine-texte);
    font-size: 0.8125rem;
  }
  .barre__interieur {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 2.5rem;
  }
  .barre__adresse {
    display: none;
  }
  .barre__droite {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }
  .barre a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .barre a:hover {
    color: var(--color-blanc);
  }
  .barre :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--color-or-clair);
  }
  .barre__courriel {
    display: none !important;
  }
  .langues {
    display: flex;
    gap: 0.15rem;
    padding-left: 1.25rem;
    border-left: 1px solid color-mix(in srgb, var(--color-marine-texte) 30%, transparent);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .langues span,
  .langues a {
    display: inline-block;
    padding: 0.35rem 0.4rem;
  }
  .langues span {
    color: var(--color-or-clair);
  }
  @media (min-width: 48rem) {
    .barre__adresse {
      display: block;
    }
  }
  @media (min-width: 64rem) {
    .barre__courriel {
      display: inline-flex !important;
    }
  }

  /* --- Kopfzeile ---------------------------------------------------------- */
  .tete-site {
    background: var(--color-blanc);
    border-bottom: 1px solid var(--color-trait);
  }
  .tete-site__interieur {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: var(--entete);
  }
  .marque img {
    display: block;
    height: 3.25rem;
    width: auto;
  }

  .menu ul {
    display: flex;
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
  }
  .menu a {
    position: relative;
    display: block;
    padding-block: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-encre);
    text-decoration: none;
  }
  .menu a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-or);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu a:hover::after,
  .menu a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .menu__pied {
    display: none;
  }

  .menu-bouton {
    display: none;
  }

  @media (max-width: 63.99rem) {
    .menu-bouton {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 0.25rem;
      background: none;
      border: 0;
      color: var(--color-encre);
      font-weight: 600;
      font-size: 0.9375rem;
      cursor: pointer;
    }
    .menu-bouton :global(svg) {
      width: 1.5rem;
      height: 1.5rem;
    }
    .menu-bouton :global(.menu-bouton__fermer),
    :global(.menu-ouvert) .menu-bouton :global(.menu-bouton__ouvrir) {
      display: none;
    }
    :global(.menu-ouvert) .menu-bouton :global(.menu-bouton__fermer) {
      display: block;
    }

    /* Ohne JavaScript: das Menue steht als Liste unter dem Wappen. */
    .menu {
      display: none;
    }
    :global(.menu-ouvert) .menu {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: fixed;
      inset: calc(2.5rem + var(--entete)) 0 0 0;
      background: var(--color-marine);
      padding: 2rem var(--gouttiere) 2.5rem;
      overflow-y: auto;
      z-index: 60;
    }
    :global(.menu-ouvert) {
      overflow: hidden;
    }
    .menu ul {
      flex-direction: column;
      gap: 0;
    }
    .menu a {
      font-family: var(--font-titre);
      font-size: 1.75rem;
      font-weight: 300;
      color: var(--color-blanc);
      padding-block: 0.7rem;
      border-bottom: 1px solid color-mix(in srgb, var(--color-marine-texte) 25%, transparent);
    }
    .menu a::after {
      display: none;
    }
    .menu a[aria-current='page'] {
      color: var(--color-or-clair);
    }
    .menu__pied {
      display: grid;
      gap: 0.35rem;
      margin-top: 2.5rem;
      color: var(--color-marine-texte);
      font-size: 0.9375rem;
    }
    .menu__pied a {
      font-family: var(--font-texte);
      font-size: 1rem;
      color: var(--color-or-clair);
      border: 0;
      padding: 0;
    }
  }

</style>
