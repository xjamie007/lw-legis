---
/**
 * src/components/Formulaire.astro — Das Kontaktformular.
 *
 * Felder und Beschriftungen wie auf der alten Seite (Nom et prénom,
 * Société, Adresse, Téléphone, Email, Demande, Einwilligung), dazu die
 * Auswahl der Taetigkeit. Kommt man von einer Taetigkeitsseite
 * (?domaine=<id>), ist sie vorbelegt.
 *
 * Ohne JavaScript geht das Formular als gewoehnlicher POST an die Edge
 * Function `send-inquiry`, die mit 303 auf die Bestaetigungsseite
 * weiterleitet. Mit JavaScript wird am Feld geprueft und ohne
 * Seitenwechsel gesendet (src/scripts/formulaire.ts).
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t, type Cle } from '../lib/i18n';
import { activites, contenu } from '../lib/content';
import { adresse } from '../lib/pages';
import { absolu } from '../lib/seo';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = contenu.pages.contact;
const recu = adresse('recu', lang) ?? '/';
const urlDonnees = adresse('donnees', lang) ?? adresse('donnees', 'fr');
const pointDeReception = `${import.meta.env.PUBLIC_SUPABASE_URL ?? ''}/functions/v1/send-inquiry`;

const messages = Object.fromEntries(
  (
    [
      'formulaire.erreur_nom',
      'formulaire.erreur_courriel',
      'formulaire.erreur_telephone',
      'formulaire.erreur_demande',
      'formulaire.erreur_consentement',
      'formulaire.erreur_envoi',
      'formulaire.envoi',
      'formulaire.envoyer',
    ] as Cle[]
  ).map((c) => [c, t(lang, c)]),
);
const obligatoire = t(lang, 'formulaire.obligatoire');
---

<form
  class="formulaire"
  id="formulaire"
  method="post"
  action={pointDeReception}
  novalidate
  data-formulaire
  data-recu={recu}
  data-messages={JSON.stringify(messages)}
>
  <div class="formulaire__resume" role="alert" tabindex="-1" data-resume hidden>
    <p>{t(lang, 'formulaire.erreur_titre')}</p>
    <ul data-resume-liste></ul>
  </div>

  <input type="hidden" name="langue" value={lang} />
  <input type="hidden" name="page" value={Astro.url.pathname} />
  <input type="hidden" name="recu" value={absolu(recu)} />

  {/* Falle fuer Formular-Roboter: Menschen sehen das Feld nicht. */}
  <div class="formulaire__piege" aria-hidden="true">
    <label for="site_web">Site web</label>
    <input id="site_web" name="site_web" tabindex="-1" autocomplete="off" />
  </div>

  <div class="formulaire__grille">
    <div class="champ champ--large">
      <label for="nom">{t(lang, 'formulaire.nom')} <abbr title={obligatoire}>*</abbr></label>
      <input id="nom" name="nom" autocomplete="name" required aria-describedby="erreur-nom" />
      <p class="champ__erreur" id="erreur-nom" data-erreur="nom" hidden></p>
    </div>
    <div class="champ">
      <label for="societe">{t(lang, 'formulaire.societe')}</label>
      <input id="societe" name="societe" autocomplete="organization" />
    </div>
    <div class="champ">
      <label for="adresse">{t(lang, 'formulaire.adresse')}</label>
      <input id="adresse" name="adresse" autocomplete="street-address" />
    </div>
    <div class="champ">
      <label for="telephone">{t(lang, 'formulaire.telephone')} <abbr title={obligatoire}>*</abbr></label>
      <input id="telephone" name="telephone" type="tel" autocomplete="tel" required aria-describedby="erreur-telephone" />
      <p class="champ__erreur" id="erreur-telephone" data-erreur="telephone" hidden></p>
    </div>
    <div class="champ">
      <label for="courriel">{t(lang, 'formulaire.courriel')} <abbr title={obligatoire}>*</abbr></label>
      <input id="courriel" name="courriel" type="email" autocomplete="email" required aria-describedby="erreur-courriel" />
      <p class="champ__erreur" id="erreur-courriel" data-erreur="courriel" hidden></p>
    </div>
    <div class="champ champ--large">
      <label for="domaine">{t(lang, 'formulaire.domaine')}</label>
      <select id="domaine" name="domaine" data-domaine>
        <option value="">{t(lang, 'formulaire.domaine_aucun')}</option>
        {activites(lang).map((a) => <option value={a.id}>{txt(a.terme, lang)}</option>)}
      </select>
    </div>
    <div class="champ champ--large">
      <label for="message">{t(lang, 'formulaire.demande')} <abbr title={obligatoire}>*</abbr></label>
      <textarea id="message" name="message" rows="7" required aria-describedby="erreur-message"></textarea>
      <p class="champ__erreur" id="erreur-message" data-erreur="message" hidden></p>
    </div>
  </div>

  <div class="consentement">
    <input id="consentement" name="consentement" type="checkbox" value="1" required aria-describedby="erreur-consentement" />
    <label for="consentement">{txt(p.consentement, lang)}</label>
  </div>
  <p class="champ__erreur" id="erreur-consentement" data-erreur="consentement" hidden></p>

  <p class="formulaire__note">
    {
      urlDonnees ? (
        <a href={urlDonnees}>{txt(p.note_droits, lang)}</a>
      ) : (
        txt(p.note_droits, lang)
      )
    }
  </p>

  <button class="bouton" type="submit" data-envoi>{t(lang, 'formulaire.envoyer')}</button>
</form>

<script>
  import '../scripts/formulaire.ts';
</script>

<style>
  .formulaire__grille {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 40rem) {
    .formulaire__grille {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1.75rem;
    }
    .champ--large {
      grid-column: 1 / -1;
    }
  }
  .champ label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.9063rem;
    font-weight: 600;
    color: var(--color-encre);
  }
  .champ abbr {
    color: var(--color-gris);
    text-decoration: none;
  }
  .champ input,
  .champ select,
  .champ textarea {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #858e9b;
    border-radius: 0;
    background: var(--color-blanc);
    color: var(--color-encre);
    transition:
      border-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }
  .champ textarea {
    resize: vertical;
    line-height: 1.55;
  }
  .champ input:hover,
  .champ select:hover,
  .champ textarea:hover {
    border-color: var(--color-gris);
  }
  .champ input:focus,
  .champ select:focus,
  .champ textarea:focus {
    outline: none;
    border-color: var(--color-marine);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-marine) 18%, transparent);
  }
  .champ [aria-invalid='true'] {
    border-color: #a32020;
  }
  .champ__erreur {
    margin-top: 0.4rem;
    color: #a32020;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .consentement {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    margin-top: 1.75rem;
    font-size: 0.9063rem;
    line-height: 1.55;
  }
  .consentement input {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    accent-color: var(--color-marine);
  }
  .formulaire__note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-gris);
  }
  .formulaire__note a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .formulaire .bouton {
    margin-top: 2rem;
  }
  .formulaire__resume {
    margin-bottom: 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid #a32020;
    color: #a32020;
    font-size: 0.9375rem;
  }
  .formulaire__resume ul {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    list-style: disc;
  }
  .formulaire__piege {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
