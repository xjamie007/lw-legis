---
/**
 * src/components/Formulaire.astro — Anfrageformular.
 *
 * So wenige Felder wie moeglich — und genau die, die eine Antwort ohne
 * Rueckfrage ermoeglichen. Bei einer grenzueberschreitenden Kanzlei sind
 * das Wohnsitzland (entscheidet ueber anwendbares Recht und Doppel-
 * besteuerung) und eine etwaige Frist (entscheidet, ob die Kanzlei
 * ueberhaupt noch annehmen kann).
 *
 * Ohne JavaScript: das Formular wird ganz gewoehnlich abgeschickt. Die
 * Edge Function nimmt es entgegen und leitet mit 303 auf die
 * Bestaetigungsseite weiter.
 * Mit JavaScript: Pruefung am Feld, Fehlermeldungen direkt daneben, und
 * der Versand laeuft ohne Seitenwechsel.
 *
 * BEWUSST KEIN DATEI-UPLOAD. Vertraege, Schreiben und Urteile sind
 * berufsgeheimnisgeschuetzt; ein offenes Upload-Feld auf einer Website ist
 * dafuer der falsche Kanal.
 *
 * Spamschutz: Honeypot plus serverseitige Pruefung. Kein Captcha —
 * Captchas kosten echte Anfragen, und bei einem Publikum jenseits der 60
 * kosten sie besonders viele.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import { paysOptions, projetOptions } from '../lib/content';
import { seg } from '../lib/routes';

interface Props {
  lang: Lang;
  /** Vorauswahl, wenn das Formular aus einer Konstellation heraus kommt. */
  paysPrechoisi?: string | null;
  projetPrechoisi?: string | null;
  /** Ueberschriftenebene, damit die Hierarchie je Seite stimmt. */
  niveau?: 2 | 3;
  id?: string;
}

const {
  lang,
  paysPrechoisi = null,
  projetPrechoisi = null,
  niveau = 2,
  id = 'formulaire',
} = Astro.props;

const pays = paysOptions(lang);
const projets = projetOptions(lang);

const segDonnees = seg('donnees', lang);
const segRecu = seg('recu', lang);
const lienDonnees = segDonnees ? `/${lang}/${segDonnees}/` : null;
const urlRecu = segRecu ? `/${lang}/${segRecu}/` : `/${lang}/`;

/** Die Edge Function nimmt die Anfrage entgegen. */
const pointDeReception = `${import.meta.env.PUBLIC_SUPABASE_URL ?? ''}/functions/v1/send-inquiry`;

/**
 * Nur die Meldungen, die das Skript im Browser wirklich braucht — und nur
 * in der Sprache dieser Seite. Auch Formularfehler werden uebersetzt.
 */
const messages = Object.fromEntries(
  (
    [
      'formulaire.erreur_nom',
      'formulaire.erreur_courriel',
      'formulaire.erreur_pays',
      'formulaire.erreur_projet',
      'formulaire.erreur_echeance',
      'formulaire.erreur_message',
      'formulaire.erreur_consentement',
      'formulaire.erreur_generale',
      'formulaire.envoyer',
      'formulaire.envoi_en_cours',
    ] as const
  ).map((c) => [c, t(lang, c)]),
);

const Titre = niveau === 2 ? 'h2' : 'h3';
---

<div class="formulaire" id={id}>
  <Titre class="titre-2">{t(lang, 'formulaire.titre')}</Titre>

  {/* Fehlerzusammenfassung. Bekommt bei einem Fehler den Fokus, damit
      Screenreader und Tastaturnutzer sofort dort landen. */}
  <div
    class="formulaire__resume"
    id={`${id}-resume`}
    role="alert"
    tabindex="-1"
    hidden
    data-resume
  >
    <p class="formulaire__resume-titre">{t(lang, 'formulaire.erreur_titre')}</p>
    <ul class="formulaire__resume-liste" data-resume-liste></ul>
  </div>

  <form
    class="formulaire__corps"
    method="post"
    action={pointDeReception}
    data-formulaire
    data-recu={urlRecu}
    data-lang={lang}
    data-messages={JSON.stringify(messages)}
    novalidate
  >
    <input type="hidden" name="langue" value={lang} />
    <input type="hidden" name="page" value={Astro.url.pathname} />

    {/* Honeypot: fuer Menschen unsichtbar und aus der Tabulatorreihenfolge
        genommen, fuer Screenreader ausgeblendet. Ausgefuellt = Maschine. */}
    <div class="formulaire__piege" aria-hidden="true">
      <label for={`${id}-societe`}>Ne pas remplir</label>
      <input
        type="text"
        id={`${id}-societe`}
        name="societe"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="champ">
      <label class="champ__label" for={`${id}-nom`}>
        {t(lang, 'formulaire.nom')}
      </label>
      <input
        class="champ__saisie"
        type="text"
        id={`${id}-nom`}
        name="nom"
        autocomplete="name"
        required
        aria-describedby={`${id}-nom-err`}
      />
      <p class="champ__erreur" id={`${id}-nom-err`} data-erreur></p>
    </div>

    <div class="champ">
      <label class="champ__label" for={`${id}-courriel`}>
        {t(lang, 'formulaire.courriel')}
      </label>
      <input
        class="champ__saisie"
        type="email"
        id={`${id}-courriel`}
        name="courriel"
        autocomplete="email"
        inputmode="email"
        required
        aria-describedby={`${id}-courriel-err`}
      />
      <p class="champ__erreur" id={`${id}-courriel-err`} data-erreur></p>
    </div>

    <div class="champ">
      <label class="champ__label" for={`${id}-telephone`}>
        {t(lang, 'formulaire.telephone')}
        <span class="champ__note">{t(lang, 'formulaire.facultatif')}</span>
      </label>
      <input
        class="champ__saisie"
        type="tel"
        id={`${id}-telephone`}
        name="telephone"
        autocomplete="tel"
        inputmode="tel"
        aria-describedby={`${id}-telephone-aide`}
      />
      <p class="champ__aide" id={`${id}-telephone-aide`}>
        {t(lang, 'formulaire.telephone_aide')}
      </p>
    </div>

    <div class="champ">
      <label class="champ__label" for={`${id}-pays`}>
        {t(lang, 'formulaire.pays')}
      </label>
      <select
        class="champ__saisie champ__saisie--choix"
        id={`${id}-pays`}
        name="pays"
        required
        aria-describedby={`${id}-pays-err`}
      >
        <option value="">{t(lang, 'formulaire.choisir')}</option>
        {
          pays.map((p) => (
            <option value={p.id} selected={p.id === paysPrechoisi}>
              {txt(p.etiquette, lang)}
            </option>
          ))
        }
      </select>
      <p class="champ__erreur" id={`${id}-pays-err`} data-erreur></p>
    </div>

    <div class="champ">
      <label class="champ__label" for={`${id}-projet`}>
        {t(lang, 'formulaire.projet')}
      </label>
      <select
        class="champ__saisie champ__saisie--choix"
        id={`${id}-projet`}
        name="projet"
        required
        aria-describedby={`${id}-projet-err`}
      >
        <option value="">{t(lang, 'formulaire.choisir')}</option>
        {
          projets.map((p) => (
            <option value={p.id} selected={p.id === projetPrechoisi}>
              {txt(p.etiquette, lang)}
            </option>
          ))
        }
      </select>
      <p class="champ__erreur" id={`${id}-projet-err`} data-erreur></p>
    </div>

    <fieldset class="champ champ--groupe">
      <legend class="champ__label">{t(lang, 'formulaire.echeance')}</legend>
      <p class="champ__aide" id={`${id}-echeance-aide`}>
        {t(lang, 'formulaire.echeance_aide')}
      </p>
      <div class="champ__bascule">
        <input
          type="checkbox"
          id={`${id}-sans-echeance`}
          name="sans_echeance"
          value="1"
          data-sans-echeance
        />
        <label for={`${id}-sans-echeance`}>{t(lang, 'formulaire.echeance_aucune')}</label>
      </div>
      <label class="champ__label champ__label--petit" for={`${id}-echeance`}>
        {t(lang, 'formulaire.echeance_date')}
      </label>
      <input
        class="champ__saisie champ__saisie--date"
        type="date"
        id={`${id}-echeance`}
        name="echeance"
        aria-describedby={`${id}-echeance-aide ${id}-echeance-err`}
        data-echeance
      />
      <p class="champ__erreur" id={`${id}-echeance-err`} data-erreur></p>
    </fieldset>

    <div class="champ">
      <label class="champ__label" for={`${id}-message`}>
        {t(lang, 'formulaire.message')}
      </label>
      <textarea
        class="champ__saisie champ__saisie--texte"
        id={`${id}-message`}
        name="message"
        rows="7"
        required
        aria-describedby={`${id}-message-err`}></textarea>
      <p class="champ__erreur" id={`${id}-message-err`} data-erreur></p>
    </div>

    <p class="note formulaire__pieces">{t(lang, 'formulaire.pieces')}</p>

    <div class="champ champ--case">
      <input
        type="checkbox"
        id={`${id}-consentement`}
        name="consentement"
        value="1"
        required
        aria-describedby={`${id}-consentement-err`}
      />
      <label class="champ__label champ__label--case" for={`${id}-consentement`}>
        {t(lang, 'formulaire.consentement')}
        {
          lienDonnees && (
            <>
              {' '}
              <a href={lienDonnees}>{t(lang, 'formulaire.consentement_lien')}</a>
            </>
          )
        }
      </label>
      <p class="champ__erreur" id={`${id}-consentement-err`} data-erreur></p>
    </div>

    {/* Pflichthinweis unmittelbar ueber dem Absendeknopf. */}
    <p class="note formulaire__mandat">{t(lang, 'formulaire.avertissement_mandat')}</p>

    <button class="bouton formulaire__envoi" type="submit" data-envoi>
      {t(lang, 'formulaire.envoyer')}
    </button>
  </form>
</div>

<script>
  import '../scripts/formulaire.ts';
</script>

<style>
  .formulaire__corps {
    margin-top: 1.75rem;
    max-width: 38rem;
  }

  .champ {
    margin-bottom: 1.5rem;
  }
  .champ--groupe {
    border: 0;
    padding: 0;
    margin-inline: 0;
  }

  .champ__label {
    display: block;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    font-weight: 500;
    color: var(--color-encre);
    margin-bottom: 0.4rem;
    padding: 0;
  }
  .champ__label--petit {
    font-weight: 400;
    color: var(--color-pierre);
    margin-top: 0.9rem;
  }
  .champ__note {
    font-weight: 400;
    color: var(--color-pierre);
    margin-left: 0.4rem;
  }

  .champ__saisie {
    display: block;
    width: 100%;
    min-height: 2.75rem;
    padding: 0.65rem 0.8rem;
    font-family: var(--font-commande);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--color-encre);
    background-color: var(--color-craie);
    border: 1.5px solid color-mix(in srgb, var(--color-pierre) 45%, transparent);
    border-radius: var(--radius-commande);
  }
  .champ__saisie:hover {
    border-color: var(--color-pierre);
  }
  .champ__saisie:focus-visible {
    border-color: var(--color-frontiere);
  }
  .champ__saisie--texte {
    min-height: 8rem;
    resize: vertical;
  }
  .champ__saisie--date {
    max-width: 14rem;
  }
  .champ__saisie--choix {
    /* Am Handy oeffnet das die native, bildschirmfuellende Auswahlliste. */
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-laiton-texte) 50%),
      linear-gradient(135deg, var(--color-laiton-texte) 50%, transparent 50%);
    background-position:
      calc(100% - 1.1rem) 1.25rem,
      calc(100% - 0.75rem) 1.25rem;
    background-size:
      0.35rem 0.35rem,
      0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }

  .champ__aide {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-pierre);
    margin-top: 0.35rem;
  }

  /* Fehler stehen am Feld, sagen was falsch ist und wie man es behebt.
     Farbe ist nicht der einzige Traeger: es steht Text da, das Feld
     bekommt aria-invalid, und der Rahmen wird dicker. */
  .champ__erreur {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-encre);
    margin-top: 0.35rem;
  }
  .champ__erreur:empty {
    display: none;
  }
  .champ__erreur::before {
    content: '';
    display: inline-block;
    width: 0.75rem;
    border-top: 1.5px solid var(--color-laiton);
    margin-right: 0.5rem;
    vertical-align: 0.3em;
  }
  .champ__saisie[aria-invalid='true'] {
    border-width: 2px;
    border-color: var(--color-laiton-texte);
  }

  .champ--case {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.7rem;
    align-items: start;
  }
  .champ--case input,
  .champ__bascule input {
    /* 24x24 Mindestgroesse fuer die Klickflaeche. */
    width: 1.5rem;
    height: 1.5rem;
    margin: 0.1rem 0 0;
    accent-color: var(--color-frontiere);
    flex: none;
  }
  .champ__label--case {
    margin-bottom: 0;
    font-weight: 400;
    line-height: 1.45;
  }
  .champ--case .champ__erreur {
    grid-column: 2;
  }

  .champ__bascule {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.4rem;
  }
  .champ__bascule label {
    font-family: var(--font-commande);
    font-size: var(--text-commande);
  }

  .formulaire__pieces {
    margin-bottom: 1.5rem;
  }
  .formulaire__mandat {
    margin-block: 1.75rem;
  }
  .formulaire__envoi {
    min-width: 12rem;
  }
  .formulaire__envoi[aria-disabled='true'] {
    opacity: 0.7;
    cursor: progress;
  }

  .formulaire__resume {
    margin-top: 1.5rem;
    border-left: var(--trait);
    padding: 0.2rem 0 0.2rem 1.1rem;
    max-width: 38rem;
  }
  .formulaire__resume-titre {
    font-family: var(--font-commande);
    font-weight: 500;
  }
  .formulaire__resume-liste {
    margin: 0.5rem 0 0;
    padding-left: 1.1rem;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
  }
  .formulaire__resume-liste li + li {
    margin-top: 0.3rem;
  }

  /* Honeypot: fuer Menschen unsichtbar, fuer Maschinen verlockend. */
  .formulaire__piege {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
