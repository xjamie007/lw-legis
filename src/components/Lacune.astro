---
/**
 * src/components/Lacune.astro — Sichtbare offene Stelle.
 *
 * Alles, was die Kanzlei noch liefern oder bestaetigen muss, bleibt im
 * ausgelieferten Stand sichtbar offen. Diese Auszeichnung ist absichtlich
 * nicht huebsch: sie soll auffallen, damit niemand sie uebersieht und sie
 * niemals unbemerkt online geht.
 *
 * Der Text kommt aus dem Register in content/source/ouvertes.mjs, damit
 * Website und OFFENE-PUNKTE.md dieselbe Quelle haben.
 */
import type { Lang } from '../lib/langs';
import { etiquetteOuverte, pointOuvert } from '../lib/content';

interface Props {
  /** Schluessel aus dem Register der offenen Punkte. */
  id: string;
  lang: Lang;
}
const { id, lang } = Astro.props;
const point = pointOuvert(id);
---

<span class="lacune" data-ouvert={id} title={point?.question ?? undefined}>
  {etiquetteOuverte(id, lang)}
</span>
