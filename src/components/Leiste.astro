---
/**
 * src/components/Leiste.astro — Die Schnellleiste unter dem Hero.
 *
 * Zweck: Wer die Seite oeffnet, soll in etwa fuenfzehn Sekunden wissen,
 * was diese Kanzlei macht — ohne zu scrollen, ohne zu lesen. Vier Felder,
 * je zwei bis drei Woerter, in einem dunklen Band quer ueber die Seite.
 *
 * Warum dunkel: Die Seite ist sonst durchgehend hell. Das Band setzt
 * genau dort einen Bruch, wo der Blick nach dem Hero weitergeht, und
 * traegt die Antwort auf die naheliegendste Frage. Zugleich bringt es
 * Rhythmus in eine Seite, die vorher aus lauter hellen Baendern bestand.
 *
 * Jeder Eintrag ist ein Link auf das Taetigkeitsgebiet — die Leiste ist
 * Navigation, nicht Deko.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import { contenu, familles } from '../lib/content';
import { seg } from '../lib/routes';
import { edFamille } from '../lib/edition';
import { prefixer } from '../lib/base';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const nos = familles(lang);
const sSrv = seg('services', lang);
const avocat = contenu.avocat;
---

<section class="leiste" aria-label={t(lang, 'services.tous')}>
  <div class="enveloppe">
    <ul class="leiste__liste">
      {
        nos.map((f) => (
          <li class="leiste__element">
            <a class="leiste__lien" href={sSrv ? prefixer(`/${lang}/${sSrv}/${txt(f.slug, lang)}/`) : '#'}>
              <span class="leiste__terme" {...edFamille(f.id, 'terme')}>{txt(f.terme, lang)}</span>
              <span class="leiste__kurz" {...edFamille(f.id, 'kurz')}>{txt(f.kurz, lang)}</span>
            </a>
          </li>
        ))
      }
      {/* Der fünfte Platz ist kein Tätigkeitsfeld, sondern die Zusage,
          die diese Kanzlei von den anderen trennt. */}
      <li class="leiste__element leiste__element--jahr">
        <span class="leiste__terme">{t(lang, 'commun.depuis')} {avocat.barreau_depuis}</span>
        <span class="leiste__kurz">{t(lang, 'leiste.barreau')}</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .leiste {
    background-color: var(--color-encre);
    background-image: linear-gradient(
      160deg,
      var(--color-encre) 0,
      var(--color-encre-tief) 100%
    );
    color: var(--color-craie);
    padding-block: 1.75rem;
  }

  .leiste__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .leiste__element {
    /* Die Messinglinie trennt die Felder. Am Handy waagerecht zwischen
       den Zeilen, ab Tablet senkrecht zwischen den Spalten. */
    border-top: 1px solid color-mix(in srgb, var(--color-laiton) 40%, transparent);
  }
  .leiste__element:first-child {
    border-top: 0;
  }

  .leiste__lien,
  .leiste__element--jahr {
    display: block;
    padding: 0.85rem 0;
    text-decoration: none;
    color: inherit;
  }

  .leiste__terme {
    display: block;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    font-weight: 500;
    /* Messing auf dem warmen Dunkel: 4,54:1, geprüft. */
    color: var(--color-laiton-clair);
    line-height: 1.3;
  }
  .leiste__kurz {
    display: block;
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-craie-gedaempft);
    margin-top: 0.15rem;
    line-height: 1.35;
  }

  .leiste__element--jahr .leiste__terme {
    color: var(--color-craie);
  }

  @media (hover: hover) and (pointer: fine) {
    .leiste__lien {
      transition: background-color 200ms ease-out;
    }
    .leiste__lien:hover {
      background-color: color-mix(in srgb, var(--color-laiton) 14%, transparent);
    }
    .leiste__lien:hover .leiste__kurz {
      color: var(--color-craie);
    }
  }

  @media (min-width: 45rem) {
    .leiste__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
    .leiste__element:nth-child(2) {
      border-top: 0;
    }
  }

  @media (min-width: 68rem) {
    .leiste {
      padding-block: 1.5rem;
    }
    .leiste__liste {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      column-gap: 0;
    }
    .leiste__element {
      border-top: 0;
      border-left: 1px solid color-mix(in srgb, var(--color-laiton) 40%, transparent);
      padding-left: 1.5rem;
    }
    .leiste__element:first-child {
      border-left: 0;
      padding-left: 0;
    }
    .leiste__lien,
    .leiste__element--jahr {
      padding-block: 0.35rem;
      padding-right: 1rem;
      min-height: 3.25rem;
    }
    .leiste__lien:hover {
      /* Auf der Spaltenfassung greift der Hover über die volle Spalte. */
      margin-inline: -0.75rem;
      padding-inline: 0.75rem;
      border-radius: var(--radius-commande);
    }
  }
</style>
