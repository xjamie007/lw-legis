---
/**
 * src/components/Marge.astro — Randspalte.
 *
 * Wird als Geschwister DIREKT HINTER den Absatz gesetzt, zu dem sie
 * gehoert, innerhalb eines `.colonne`-Rasters. Die Platzierungsregel von
 * CSS Grid setzt sie dann in dieselbe Zeile wie diesen Absatz — ohne
 * zusaetzliches Markup und ohne JavaScript.
 *
 * Am Handy faellt die Spalte weg und die Marginalie steht unter ihrem
 * Absatz, als kleiner Nebensatz mit kurzem Messingstrich, nicht als Kasten.
 */
import type { Edition } from '../lib/edition';

interface Props {
  terme?: string | null;
  class?: string;
  /** Anklickbar im Redaktionsbereich — siehe src/lib/edition.ts. */
  edTerme?: Edition;
  edTexte?: Edition;
}
const { terme = null, class: klass, edTerme, edTexte } = Astro.props;
---

<aside class:list={['marge', klass]} data-revele="marge">
  {terme && <b class="marge__terme" {...edTerme}>{terme}</b>}
  {edTexte ? <span {...edTexte}><slot /></span> : <slot />}
</aside>
