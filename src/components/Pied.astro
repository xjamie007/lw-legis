---
/**
 * src/components/Pied.astro — Fussbereich.
 *
 * Dunkelgruen als Flaeche, Messing als Linie. Die Anschrift steht hier
 * genau einmal und exakt so wie ueberall sonst — NAP-Konsistenz ist fuer
 * das lokale Ranking entscheidend, und abweichende Schreibweisen der
 * Strasse kosten Sichtbarkeit.
 *
 * Fuer Text auf dunklem Grund gilt `laiton-clair`, nicht `laiton`: das
 * urspruengliche Messing erreicht gegen `encre` nur 4,42:1 und verfehlt
 * die 4,5:1 knapp. Siehe docs/kontrast.md.
 */
import type { Lang } from '../lib/langs';
import { t, type Cle } from '../lib/i18n';
import { contenu } from '../lib/content';
import { seg, type NomSegment } from '../lib/routes';
import Wappen from './Wappen.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const s = contenu.settings;

const liensLegaux = contenu.pied
  .filter((p) => p.visible)
  .sort((a, b) => a.ordre - b.ordre)
  .map((p) => ({
    cle: p.cle as Cle,
    href: (() => {
      const x = seg(p.segment as NomSegment, lang);
      return x ? `/${lang}/${x}/` : null;
    })(),
  }))
  .filter((p): p is { cle: Cle; href: string } => p.href !== null);

const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="enveloppe pied__grille">
    <div class="pied__bloc pied__bloc--marque">
      {/* Das Wappen steht dort, wo es hingehört: auf dunklem Grund, in
          Messing — so wie das Schild an der avenue du X Septembre. */}
      <Wappen groesse="gross" dunkel />
    </div>

    <div class="pied__bloc">
      <h2 class="pied__titre">{t(lang, 'contact.adresse')}</h2>
      <address class="pied__adresse">
        {s.adresse.rue}<br />
        {s.adresse.code_postal}&nbsp;{s.adresse.ville}<br />
        <span class="pied__quartier">{s.adresse.quartier}</span>
      </address>
    </div>

    <div class="pied__bloc">
      <h2 class="pied__titre">{t(lang, 'contact.telephone')}</h2>
      <p>
        <a href={`tel:${s.telephone.central_lien}`}>{s.telephone.central}</a>
      </p>
      <h2 class="pied__titre pied__titre--espace">{t(lang, 'contact.courriel')}</h2>
      <p>
        <a href={`mailto:${s.courriel}`}>{s.courriel}</a>
      </p>
    </div>

    <div class="pied__bloc">
      <nav aria-label={t(lang, 'pied.navigation')}>
        <ul class="pied__liens">
          {
            liensLegaux.map((l) => (
              <li>
                <a href={l.href}>{t(lang, l.cle)}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>

  <div class="enveloppe pied__bas">
    <p class="pied__mention">{t(lang, 'pied.barreau')}</p>
    <p class="pied__mention">
      © {annee} {s.nom}. {t(lang, 'pied.droits')}.
    </p>
  </div>
</footer>

<style>
  .pied {
    background-color: var(--color-encre);
    color: var(--color-craie);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4rem) 2rem;
    /* Kein margin-top: die letzte Sektion bringt ihren eigenen Abstand
       mit, und beides zusammen riss ein leeres Feld auf. */
  }

  .pied__grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .pied__bloc--marque {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .pied__marque {
    font-family: var(--font-lecture);
    font-weight: 600;
    font-size: 1.375rem;
    letter-spacing: 0.08em;
    /* Aufgehelltes Messing: 4,95:1 gegen `encre`. */
    color: var(--color-laiton-clair);
  }
  .pied__sous {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-craie-gedaempft);
    margin-top: 0.25rem;
  }

  .pied__titre {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    font-weight: 500;
    color: var(--color-craie-gedaempft);
    margin-bottom: 0.4rem;
  }
  .pied__titre--espace {
    margin-top: 1.1rem;
  }

  .pied__bloc p,
  .pied__adresse {
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    font-style: normal;
    line-height: 1.55;
  }

  .pied__quartier {
    color: var(--color-craie-gedaempft);
  }

  .pied__bloc a {
    color: var(--color-craie);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .pied__bloc a:hover {
    color: var(--color-laiton-clair);
  }

  .pied__liens {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pied__liens li + li {
    margin-top: 0.6rem;
  }
  /* Dauerhaft unterstrichen, nicht erst beim Überfahren. In einer
     Fußzeile aus lauter hellem Text auf dunklem Grund wäre die Farbe
     sonst das einzige Merkmal eines Links — und Farbe darf nie der
     einzige Bedeutungsträger sein. Das Überfahren verstärkt die Linie
     und schiebt sie in Messing, es erzeugt sie nicht. */
  .pied__liens a {
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    display: inline-block;
    padding-block: 0.15rem;
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    transition:
      background-size 260ms cubic-bezier(0.22, 0.61, 0.36, 1),
      color 200ms ease-out;
  }
  @media (hover: hover) and (pointer: fine) {
    .pied__liens a:hover {
      background-size: 100% 2px;
    }
  }

  .pied__bas {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    /* Die Messinglinie darf hier Flaeche sein, nicht Text: 4,42:1 reicht
       fuer eine grafische Abgrenzung (WCAG 1.4.11, Schwelle 3:1). */
    border-top: 1.5px solid color-mix(in srgb, var(--color-laiton) 65%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
    justify-content: space-between;
  }
  .pied__mention {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-craie-gedaempft);
  }

  @media (min-width: 40rem) {
    .pied__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 3rem;
    }
  }
  @media (min-width: 62rem) {
    .pied__grille {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
