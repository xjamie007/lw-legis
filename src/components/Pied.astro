---
/**
 * src/components/Pied.astro — Fussbereich.
 *
 * Marineblau, das helle Wappen, Anschrift, Erreichbarkeit, die Seiten der
 * Kanzlei und die Rechtstexte. Die Rechtstexte gibt es nur auf
 * Franzoesisch; die englische Seite verlinkt deshalb die franzoesische
 * Fassung und sagt das mit `hreflang`.
 *
 * Neben dem ©-Hinweis steht unauffaellig „Login“, wie bei Krombach und
 * DRP: Er fuehrt in den Redaktionsbereich, der dieselbe Seite zum
 * Bearbeiten oeffnet.
 */
import type { Lang } from '../lib/langs';
import { t, type Cle } from '../lib/i18n';
import { contenu } from '../lib/content';
import { adresse } from '../lib/pages';
import { prefixer } from '../lib/base';

interface Props {
  lang: Lang;
  /** Pfad dieser Seite: Nach dem Login geht es genau hier weiter. */
  chemin: string;
}
const { lang, chemin } = Astro.props;
const s = contenu.settings;

const enLangue = (cle: string) => {
  const ici = adresse(cle, lang);
  if (ici) return { href: ici, hreflang: undefined };
  const fr = adresse(cle, 'fr');
  return fr ? { href: fr, hreflang: 'fr' } : null;
};

const pages = contenu.navigation
  .filter((n) => n.visible)
  .sort((a, b) => a.ordre - b.ordre)
  .map((n) => ({ cle: n.cle as Cle, lien: enLangue(n.id) }))
  .filter((l) => l.lien);

const legaux = contenu.pied
  .filter((n) => n.visible)
  .sort((a, b) => a.ordre - b.ordre)
  .map((n) => ({ cle: n.cle as Cle, lien: enLangue(n.id) }))
  .filter((l) => l.lien);

const index = enLangue('index');
const annee = new Date().getFullYear();
---

<footer class="pied">
  <div class="enveloppe pied__grille">
    <div class="pied__marque">
      <img src={prefixer('/bilder/wappen-hell.png')} alt={s.nom} width="694" height="240" loading="lazy" />
    </div>

    <div>
      <h2 class="pied__titre">{t(lang, 'pied.adresse')}</h2>
      <address>
        {s.adresse.rue}<br />
        {`${s.adresse.code_postal} ${s.adresse.ville}`}<br />
        <span class="pied__discret">{s.postfach.boite}</span>
      </address>
    </div>

    <div>
      <h2 class="pied__titre">{t(lang, 'pied.joindre')}</h2>
      <p><a href={`tel:${s.telephone.lien}`}>{s.telephone.affiche}</a></p>
      <p><a href={`mailto:${s.courriel}`}>{s.courriel}</a></p>
    </div>

    <nav aria-label={t(lang, 'pied.navigation')}>
      <h2 class="pied__titre">{t(lang, 'pied.navigation')}</h2>
      <ul>
        {pages.map((p) => <li><a href={p.lien!.href}>{t(lang, p.cle)}</a></li>)}
        {index && <li><a href={index.href}>{t(lang, 'nav.index')}</a></li>}
      </ul>
    </nav>
  </div>

  <div class="enveloppe pied__bas">
    <ul class="pied__legaux">
      {
        legaux.map((l) => (
          <li>
            <a href={l.lien!.href} hreflang={l.lien!.hreflang}>
              {t(lang, l.cle)}
            </a>
          </li>
        ))
      }
    </ul>
    <p>
      © {annee} {s.nom}. {t(lang, 'pied.droits')}.
      <a class="k-login" href={`${prefixer('/admin/')}?seite=${encodeURIComponent(chemin)}`} rel="nofollow">Login</a>
    </p>
    <p class="pied__nave">
      {t(lang, 'pied.realisation')} <a href="https://nave.lu" rel="noopener">Nave</a>
    </p>
  </div>
</footer>

<style>
  .pied {
    background: var(--color-marine-tief);
    color: var(--color-marine-texte);
    font-size: 0.9375rem;
    padding-top: clamp(3.5rem, 2rem + 5vw, 5.5rem);
  }
  .pied__grille {
    display: grid;
    gap: 2.5rem 3rem;
  }
  .pied__marque img {
    width: 11rem;
    height: auto;
  }
  .pied__titre {
    font-family: var(--font-texte);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-or-clair);
    margin-bottom: 1rem;
  }
  .pied address {
    font-style: normal;
    line-height: 1.7;
  }
  .pied__discret {
    opacity: 0.85;
  }
  .pied p + p {
    margin-top: 0.35rem;
  }
  .pied ul {
    display: grid;
    gap: 0.4rem;
  }
  .pied a {
    text-decoration: none;
    transition: color 200ms ease-out;
  }
  .pied a:hover {
    color: var(--color-blanc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .pied__bas {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding-block: 1.5rem 2rem;
    border-top: 1px solid color-mix(in srgb, var(--color-marine-texte) 22%, transparent);
    font-size: 0.8125rem;
  }
  .pied__legaux {
    display: flex !important;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem !important;
  }
  /* Dieselbe Farbe wie der ©-Text, damit der Kontrast stimmt. */
  .k-login {
    margin-left: 0.75em;
  }
  .pied__nave {
    flex-basis: 100%;
    opacity: 0.85;
  }
  .pied__nave a {
    color: var(--color-or-clair);
  }

  @media (min-width: 40rem) {
    .pied__grille {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 62rem) {
    .pied__grille {
      grid-template-columns: 1.3fr 1fr 1fr 1fr;
    }
  }
</style>
