---
/**
 * src/components/Wappen.astro — Das Wappen der Kanzlei.
 *
 * Das ECHTE Wappen: Buch mit „L W“, Schwert, Schriftzug
 * „ETUDE D'AVOCATS LEGIS“. Freigestellt aus den Bestaenden der Kanzlei —
 * siehe tools/originale/HERKUNFT.md und scripts/bilder-aufbereiten.mjs.
 *
 * Es liegt in zwei Farbfassungen vor, weil ein Messington nicht auf
 * beiden Gruenden funktioniert:
 *   wappen.png       #A07C3C  fuer helle Flaechen
 *   wappen-hell.png  #AB8440  fuer den dunklen Fussbereich (4,95:1)
 *
 * Quelle ist bisher ein Foto, kein Vektor. In den gebrauchten Groessen
 * reicht das; fuer beliebige Groessen waere die Originaldatei des
 * Gestalters besser — sie steht in OFFENE-PUNKTE.md.
 */
interface Props {
  /** 'klein' fuer die Kopfzeile, 'gross' fuer den Fussbereich. */
  groesse?: 'klein' | 'gross';
  /** Auf dunklem Grund? Dann die aufgehellte Fassung. */
  dunkel?: boolean;
  /** Beim ersten Laden einmal sanft aufblenden. Nur die Startseite. */
  auftritt?: boolean;
  /** Ist das Wappen die einzige Beschriftung, braucht es einen Lesenamen. */
  alt?: string;
  class?: string;
}

const {
  groesse = 'klein',
  dunkel = false,
  auftritt = false,
  alt = '',
  class: klass,
} = Astro.props;

/** Seitenverhaeltnis der freigestellten Datei: 694 × 240. */
const masse = groesse === 'klein' ? { w: 156, h: 54 } : { w: 232, h: 80 };
const datei = dunkel ? '/bilder/wappen-hell.png' : '/bilder/wappen.png';
---

<img
  class:list={['wappen', { 'wappen--auftritt': auftritt }, klass]}
  src={datei}
  alt={alt}
  width={masse.w}
  height={masse.h}
  decoding="async"
  fetchpriority={groesse === 'klein' ? 'high' : undefined}
  aria-hidden={alt === '' ? 'true' : undefined}
/>

<style>
  .wappen {
    display: block;
    flex: none;
    height: auto;
    /* Der Rahmen des Wappens ist hauchduenn. Ohne das hier verschluckt
       ihn die Pixelrasterung beim Verkleinern stellenweise. */
    image-rendering: auto;
  }

  /* Ein einziger, ruhiger Auftritt beim Laden der Startseite: das Wappen
     blendet auf und setzt sich um zwei Millimeter. Der Ruhezustand ist
     das fertige Wappen — `backwards` haelt nichts fest, laeuft die
     Animation nicht, steht es sofort da. */
  .wappen--auftritt {
    animation: wappen-auftritt 900ms cubic-bezier(0.22, 0.61, 0.36, 1) 120ms backwards;
  }

  @keyframes wappen-auftritt {
    from {
      opacity: 0;
      transform: translateY(0.35rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wappen--auftritt {
      animation: none;
    }
  }
</style>
