---
/**
 * src/pages/404.astro — Seite nicht gefunden.
 *
 * Eine Datei fuer beide Sprachen: Wer auf einer falschen Adresse landet,
 * hat oft keine Sprache gewaehlt, und der Server weiss nicht, welche
 * gemeint war. Deshalb steht hier jede gebaute Sprache mit ihren
 * wichtigsten Wegen.
 */
import '../styles/global.css';
import { LANG_BALISE, type Lang } from '../lib/langs';
import { t, type Cle } from '../lib/i18n';
import { contenu, languesDuSite } from '../lib/content';
import { adresse } from '../lib/pages';
import { urlAccueil } from '../lib/routes';
import { prefixer } from '../lib/base';

const pretes = languesDuSite();
const s = contenu.settings;

const chemins = (l: Lang) =>
  (['activites', 'dossiers', 'conferences', 'contact'] as const)
    .map((n) => {
      const href = adresse(n, l);
      return href ? { nom: t(l, `nav.${n}` as Cle), href } : null;
    })
    .filter((x): x is { nom: string; href: string } => x !== null);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page introuvable — Page not found | LW LEGIS</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href={prefixer('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#13294B" />
  </head>
  <body>
    <main class="erreur">
      <a href={urlAccueil('fr')}><img src={prefixer('/bilder/wappen.png')} alt={s.nom} width="694" height="240" /></a>
      <h1 class="visuellement-cache">Page introuvable — Page not found</h1>
      <div class="erreur__langues">
        {
          pretes.map((l) => (
            <section lang={LANG_BALISE[l]}>
              <h2>{t(l, 'erreur.titre')}</h2>
              <p>{t(l, 'erreur.texte')}</p>
              <ul>
                <li>
                  <a href={urlAccueil(l)}>{t(l, 'erreur.retour')}</a>
                </li>
                {chemins(l).map((c) => (
                  <li>
                    <a href={c.href}>{c.nom}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <p class="erreur__pied">
        {s.nom} · {s.adresse.une_ligne} · <a href={`tel:${s.telephone.lien}`}>{s.telephone.affiche}</a>
      </p>
    </main>
  </body>
</html>

<style>
  .erreur {
    max-width: 64rem;
    margin-inline: auto;
    padding: clamp(3rem, 8vw, 7rem) var(--gouttiere);
  }
  .erreur img {
    height: 3rem;
    width: auto;
  }
  .erreur__langues {
    display: grid;
    gap: 3rem;
    margin-top: 4rem;
  }
  .erreur h2 {
    font-size: var(--text-titre);
    font-weight: 300;
  }
  .erreur p {
    margin-top: 1rem;
    color: var(--color-gris);
    max-width: 40ch;
  }
  .erreur ul {
    display: grid;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }
  .erreur a {
    color: var(--color-marine);
    text-decoration-color: var(--color-or);
    text-underline-offset: 3px;
  }
  .erreur__pied {
    margin-top: 4rem !important;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-trait);
    font-size: 0.875rem;
    max-width: none !important;
  }
  @media (min-width: 48rem) {
    .erreur__langues {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
