---
/**
 * src/pages/[lang]/[...chemin].astro — Die einzige oeffentliche Route.
 *
 * Weil sich die Pfadsegmente je Sprache unterscheiden (/fr/votre-situation/
 * gegen /de/ihre-situation/), kann Astros Praefix-Routing das nicht
 * abbilden. Stattdessen erzeugt `toutesLesRoutes()` die vollstaendige
 * Adresstabelle, und diese Datei baut daraus jede Seite.
 *
 * Derselbe Tabellenaufbau speist Sitemap, hreflang, Brotkrumen und die
 * Link-Pruefung — es gibt keine zweite Liste, die abweichen koennte.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Accueil from '../../vues/Accueil.astro';
import Avocats from '../../vues/Avocats.astro';
import Activites from '../../vues/Activites.astro';
import Dossiers from '../../vues/Dossiers.astro';
import Conferences from '../../vues/Conferences.astro';
import Partenaires from '../../vues/Partenaires.astro';
import IndexMatieres from '../../vues/IndexMatieres.astro';
import Contact from '../../vues/Contact.astro';
import Recu from '../../vues/Recu.astro';
import PageLegale from '../../vues/PageLegale.astro';

import { toutesLesRoutes, alternatifsPour, adresse, type Route } from '../../lib/pages';
import { activites, dossiers, languesDuSite } from '../../lib/content';
import type { Lang } from '../../lib/langs';
import * as ld from '../../lib/jsonld';

export const getStaticPaths = (() => {
  return toutesLesRoutes().map((r) => ({
    params: {
      lang: r.lang,
      // Die Startseite hat keine weiteren Segmente.
      chemin: r.segments.length > 0 ? r.segments.join('/') : undefined,
    },
    props: { route: r },
  }));
}) satisfies GetStaticPaths;

const { route } = Astro.props as { route: Route };
const lang = route.lang as Lang;

// --- Strukturierte Daten -----------------------------------------------------
const noeuds: (Record<string, unknown> | null)[] = [
  ld.legalService(lang, languesDuSite()),
  ld.webSite(lang, route.chemin),
  ld.fildAriane(route.fil.map((e) => ({ nom: e.nom, url: e.url }))),
];

if (route.type === 'accueil' || route.type === 'avocats') noeuds.push(...ld.attorneys(lang));
if (route.type === 'accueil' || route.type === 'activites') {
  for (const a of activites(lang)) noeuds.push(ld.service(a, lang, adresse(`activite:${a.id}`, lang)!));
}
if (route.type === 'activite') noeuds.push(ld.service(route.data.activite as never, lang, route.chemin));
if (route.type === 'dossier') noeuds.push(ld.article(route.data.dossier, lang, route.chemin));
if (route.type === 'dossiers') {
  for (const d of dossiers(lang)) noeuds.push(ld.article(d, lang, adresse(`dossier:${d.id}`, lang)!));
}

const jsonld = ld.graphe(noeuds);
const alternatifs = alternatifsPour(route.cle);
---

<Base
  lang={lang}
  titre={route.titre}
  description={route.description}
  chemin={route.chemin}
  alternatifs={alternatifs}
  noindex={route.noindex}
  jsonld={jsonld}
>
  {route.type === 'accueil' && <Accueil lang={lang} />}
  {route.type === 'avocats' && <Avocats lang={lang} route={route} />}
  {route.type === 'activites' && <Activites lang={lang} route={route} />}
  {route.type === 'activite' && <Activites lang={lang} route={route} activite={route.data.activite as never} />}
  {route.type === 'dossiers' && <Dossiers lang={lang} route={route} />}
  {route.type === 'dossier' && <Dossiers lang={lang} route={route} dossier={route.data.dossier as never} />}
  {route.type === 'conferences' && <Conferences lang={lang} route={route} />}
  {route.type === 'partenaires' && <Partenaires lang={lang} route={route} />}
  {route.type === 'index' && <IndexMatieres lang={lang} route={route} />}
  {route.type === 'contact' && <Contact lang={lang} route={route} />}
  {route.type === 'recu' && <Recu lang={lang} route={route} />}
  {
    (route.type === 'mentions' || route.type === 'donnees' || route.type === 'cookies' || route.type === 'conditions') && (
      <PageLegale lang={lang} route={route} quelle={route.type} />
    )
  }
</Base>
