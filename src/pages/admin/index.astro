---
/**
 * src/pages/admin/index.astro — Der Redaktionsbereich.
 *
 * Eine eigene Seite, die NICHTS mit den oeffentlichen Seiten teilt:
 * eigenes Stylesheet, eigenes Bundle. Astro buendelt je Seite, und keine
 * oeffentliche Seite fordert diese Dateien an — nachgeprueft von
 * scripts/postbuild.mjs, das meldet, welche Bundles ungenutzt sind.
 *
 * DREIFACH gegen Indexierung gesichert:
 *   1. <meta name="robots" content="noindex, nofollow"> hier
 *   2. Disallow in robots.txt
 *   3. X-Robots-Tag in _headers (wirkt auch, wenn ein Crawler das
 *      Dokument gar nicht erst liest)
 * In der Sitemap steht /admin nicht — sie entsteht aus der Adresstabelle
 * der oeffentlichen Seiten, und die kennt den Redaktionsbereich nicht.
 *
 * Diese Seite ist die einzige der Website, die ueberhaupt etwas auf dem
 * Geraet ablegt: ein Anmeldemerkmal im localStorage, nur unter /admin.
 * Die oeffentliche Seite legt nichts ab und braucht deshalb kein
 * Cookie-Banner.
 */
import '../../styles/admin.css';
import App from '../../admin/App';
import { activites, contenu, dossiers, languesDuSite } from '../../lib/content';
import { adresse } from '../../lib/pages';
import { prefixer } from '../../lib/base';
import { demo } from '../../admin/supabase';

// Nur diese beiden Angaben gehen an den Browser, nicht der Schnappschuss:
// Darin stehen auch Entwuerfe, und das Bundle von /admin ist oeffentlich
// abrufbar. `stand` ist der Zeitpunkt, aus dem die Website gebaut wurde —
// alles, was danach gespeichert wurde, ist noch nicht online.
const stand = contenu.meta.genere_le;
const langues = languesDuSite();

// Fuer neue Seiten (src/admin/atelier/nouveau.ts): welche Eintraege die
// gebaute Website schon kennt, und auf welchen Seiten Neues gezeigt wird.
// Nur Kennungen und Adressen — keine Inhalte.
const site = {
  ids: [...contenu.familles.map((a) => a.id), ...contenu.publications.map((p) => p.id)],
  adresses: Object.fromEntries(
    langues.map((l) => [
      l,
      {
        services: activites(l)[0] ? adresse(`activite:${activites(l)[0].id}`, l) : null,
        dossier: dossiers(l)[0] ? adresse(`dossier:${dossiers(l)[0].id}`, l) : null,
        activites: adresse('activites', l),
        dossiers: adresse('dossiers', l),
        conferences: adresse('conferences', l),
      },
    ]),
  ),
};

// Demo (siehe `demo` in src/admin/supabase.ts): ohne Datenbank. Dann
// bekommt der Redaktionsbereich die Startinhalte als Tabellenzeilen mit —
// dieselbe Zuordnung wie scripts/seed-from-snapshot.mjs. Die
// Entwuerfe darin stammen alle von der alten Website, nichts Vertrauliches.
const graines = demo
  ? (() => {
      const c = contenu as any;
      const statut = (v: string) => (v === 'publie' || v === 'veroeffentlicht' ? 'veroeffentlicht' : 'entwurf');
      const ligne = (x: object) => ({ ...x, updated_at: stand });
      return {
        settings: [
          ligne({ cle: 'stammdaten', valeur: c.settings, reserve_owner: true }),
          ligne({ cle: 'pages', valeur: c.pages, reserve_owner: false }),
          ligne({ cle: 'libelles', valeur: c.libelles ?? {}, reserve_owner: false }),
        ],
        navigation: [
          ...c.navigation.map((x: any) => ligne({ ...x, cle_i18n: x.cle, emplacement: 'principale' })),
          ...c.pied.map((x: any) => ligne({ ...x, cle_i18n: x.cle, emplacement: 'pied' })),
        ],
        pages: Object.entries(c.pages).map(([id, p]: [string, any]) =>
          ligne({ id, titre: p.titre ?? {}, statut: 'veroeffentlicht' }),
        ),
        services: c.familles.map((f: any) =>
          ligne({
            id: f.id, slug: f.slug, terme: f.terme, definition: f.definition, texte: f.texte, kurz: f.kurz,
            marge_terme: f.marge?.terme ?? {}, marge_texte: f.marge?.texte ?? {}, matieres: f.matieres,
            ordre: f.ordre, statut: 'veroeffentlicht',
          }),
        ),
        publication_tags: c.themes.map((t: any, i: number) => ligne({ ...t, ordre: i })),
        publications: c.publications.map(({ pdf, statut: st, ...p }: any) =>
          ligne({ ...p, pdf_chemin: pdf?.chemin ?? null, pdf_octets: pdf?.octets ?? null, statut: statut(st) }),
        ),
        team: c.team.map((m: any) => ligne({ ...m, statut: statut(m.statut) })),
        legal_pages: Object.entries(c.legal).map(([id, p]: [string, any]) =>
          ligne({ id, ...p, blocs: p.blocs ?? [], statut: 'veroeffentlicht' }),
        ),
        seo_meta: Object.entries(c.seo).map(([id, m]: [string, any]) => ligne({ id, ...m, noindex: Boolean(m.noindex) })),
        media: [],
        inquiries: [],
        revisions: [],
        profiles: [{ id: 'demo', nom: 'Me Alain Lorang', role: 'owner', langue_admin: 'fr' }],
      };
    })()
  : null;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Administration — LW LEGIS</title>
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <link rel="icon" href={prefixer('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#151D26" />
    <link
      rel="preload"
      href={prefixer('/fonts/hanken-grotesk-roman-400-700-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <script type="application/json" id="lw-site" set:html={JSON.stringify(site)} />
    {graines && <script type="application/json" id="lw-demo-graines" set:html={JSON.stringify(graines).replace(/</g, '\\u003c')} />}
    {/* client:only — der Redaktionsbereich hat keinen Inhalt, den ein
        Server vorrendern koennte: alles haengt am angemeldeten Konto.
        Vorrendern wuerde nur eine leere Huelle erzeugen. */}
    <App client:only="react" stand={stand} langues={langues} />
    <noscript>
      <p style="padding:2rem;font-family:sans-serif">
        L’espace d’administration nécessite JavaScript. Le site public
        fonctionne entièrement sans.
      </p>
    </noscript>
  </body>
</html>
