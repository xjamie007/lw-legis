---
/**
 * src/vues/Accueil.astro — Startseite.
 *
 * Reihenfolge: Hero (wer, was, Termin), die Kanzlei mit Me Lorang, die
 * Taetigkeiten als Register, die Staerken, Netzwerke und Vertretungen,
 * Dossiers und Konferenzen, „Pourquoi un avocat“, Kontakt.
 * Alle Texte stammen von der alten Seite (content/source/pages.mjs).
 */
import type { Lang } from '../lib/langs';
import { txt, txtOuFrancais, txtHtml } from '../lib/langs';
import { t } from '../lib/i18n';
import { activites, conferences, contenu, dossiers, equipe } from '../lib/content';
import { adresse } from '../lib/pages';
import { ed, edPage } from '../lib/edition';
import { formaterTaille } from '../lib/i18n';
import { prefixer } from '../lib/base';
import Bild from '../components/Bild.astro';
import Icone from '../components/Icone.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = contenu.pages.accueil;
const s = contenu.settings;

const lorang = equipe(lang).find((m) => m.id === 'alain-lorang');
const liste = activites(lang);
const derniersDossiers = dossiers(lang).slice(0, 4);
const dernieresConferences = conferences().filter((c) => c.pdf).slice(0, 4);

const urlContact = adresse('contact', lang);
const urlAvocats = adresse('avocats', lang);
const urlActivites = adresse('activites', lang);
const urlDossiers = adresse('dossiers', lang);
const urlConferences = adresse('conferences', lang);
---

<section class="hero">
  <div class="hero__texte">
    <h1 {...edPage('accueil.titre')}>{txt(p.titre, lang)}</h1>
    <p class="hero__intro" {...edPage('accueil.intro')}>{txt(p.intro, lang)}</p>
    <div class="hero__actions">
      {
        urlContact && (
          <a class="bouton bouton--or" href={urlContact}>
            {t(lang, 'accueil.rendez_vous')}
            <Icone nom="fleche" />
          </a>
        )
      }
      <a class="hero__tel" href={`tel:${s.telephone.lien}`}>
        <span>{t(lang, 'accueil.ou_appeler')}</span>
        {s.telephone.affiche}
      </a>
    </div>
  </div>
  <div class="hero__image">
    <Bild platz="bureau_1" lang={lang} sizes="(min-width: 62rem) 45vw, 100vw" eifrig />
  </div>
  <ul class="hero__preuves">
    <li>{t(lang, 'accueil.preuve_1')}</li>
    <li>{t(lang, 'accueil.preuve_2')}</li>
    <li>{t(lang, 'accueil.preuve_3')}</li>
  </ul>
</section>

<section class="section">
  <div class="enveloppe etude">
    <div class="etude__texte">
      <h2 class="titre-section filet" {...edPage('accueil.cabinet_titre')}>{txt(p.cabinet_titre, lang)}</h2>
      <div class="prose" set:html={txtHtml(p.cabinet_texte, lang)} {...edPage('accueil.cabinet_texte', true)} />
    </div>
    {
      lorang && (
        <figure class="etude__portrait">
          <Bild platz="portrait" lang={lang} sizes="(min-width: 62rem) 24rem, 80vw" />
          <figcaption>
            <span class="etude__nom">
              {lorang.titre_civil} {lorang.nom}
            </span>
            <span {...ed('team', lorang.id, 'fonction')}>{txt(lorang.fonction, lang)}</span>
            {
              urlAvocats && (
                <a class="lien-fleche" href={urlAvocats}>
                  {t(lang, 'nav.avocats')}
                  <Icone nom="fleche" />
                </a>
              )
            }
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<section class="section section--brume">
  <div class="enveloppe">
    <div class="entete-section">
      <h2 class="titre-section filet">{t(lang, 'accueil.activites_titre')}</h2>
      <p class="chapeau" {...edPage('activites.intro')}>{txt(contenu.pages.activites.intro, lang)}</p>
    </div>
    <ul class="registre registre--deux">
      {
        liste.map((a) => (
          <li class="registre__ligne">
            <a class="registre__lien" href={adresse(`activite:${a.id}`, lang)}>
              <span class="registre__titre" {...ed('services', a.id, 'terme')}>
                {txt(a.terme, lang)}
              </span>
              <span class="registre__texte">{txt(a.definition, lang)}</span>
              <Icone nom="fleche" class="registre__fleche" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section section--marine atouts">
  <div class="enveloppe">
    <h2 class="titre-section filet" {...edPage('accueil.atouts_titre')}>{txt(p.atouts_titre, lang)}</h2>
    <ol class="atouts__liste">
      {
        p.atouts.map((a: any, i: number) => (
          <li>
            <span class="atouts__titre" {...edPage(`accueil.atouts.${i}.titre`)}>
              {txt(a.titre, lang)}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="section">
  <div class="enveloppe specialiste">
    <div>
      <h2 class="titre-section filet" {...edPage('accueil.specialiste_titre')}>{txt(p.specialiste_titre, lang)}</h2>
      <div class="prose" set:html={txtHtml(p.specialiste_texte, lang)} {...edPage('accueil.specialiste_texte', true)} />
    </div>
    <aside class="reseaux" aria-labelledby="titre-reseaux">
      <h3 id="titre-reseaux">{t(lang, 'accueil.reseaux_titre')}</h3>
      <dl>
        {
          s.reseaux.map((r: any) => (
            <div>
              <dt>{r.nom}</dt>
              <dd>{txt(r.role, lang)}</dd>
            </div>
          ))
        }
      </dl>
    </aside>
  </div>
</section>

<section class="section section--brume">
  <div class="enveloppe publications">
    <div>
      <h2 class="titre-section filet">{t(lang, 'nav.dossiers')}</h2>
      <ul class="registre">
        {
          derniersDossiers.map((d) => (
            <li class="registre__ligne">
              <a class="registre__lien" href={adresse(`dossier:${d.id}`, lang)}>
                <span class="registre__titre">{txt(d.titre, lang)}</span>
                <span class="registre__texte">{txt(d.resume, lang)}</span>
                <Icone nom="fleche" class="registre__fleche" />
              </a>
            </li>
          ))
        }
      </ul>
      {
        urlDossiers && (
          <a class="lien-fleche publications__tous" href={urlDossiers}>
            {t(lang, 'accueil.dossiers_tous')}
            <Icone nom="fleche" />
          </a>
        )
      }
    </div>
    <div>
      <h2 class="titre-section filet">{t(lang, 'nav.conferences')}</h2>
      <p class="chapeau" {...edPage('accueil.conferences_texte')}>{txt(p.conferences_texte, lang)}</p>
      <ul class="registre publications__conf">
        {
          dernieresConferences.map((c) => {
            const titre = txtOuFrancais(c.titre, lang);
            return (
              <li class="registre__ligne">
                <a class="registre__lien" href={prefixer(c.pdf!.chemin)} download>
                  <span class="registre__titre" lang={titre.lang !== lang ? titre.lang : undefined}>
                    {titre.valeur}
                  </span>
                  <span class="etiquettes">
                    <span>PDF · {formaterTaille(c.pdf!.octets, lang)}</span>
                    {titre.lang !== lang && <span>{t(lang, 'conferences.en_francais')}</span>}
                  </span>
                  <Icone nom="telecharger" class="registre__fleche" />
                </a>
              </li>
            );
          })
        }
      </ul>
      {
        urlConferences && (
          <a class="lien-fleche publications__tous" href={urlConferences}>
            {t(lang, 'accueil.conferences_toutes')}
            <Icone nom="fleche" />
          </a>
        )
      }
    </div>
  </div>
</section>

<section class="section">
  <div class="enveloppe pourquoi">
    <h2 class="titre-section filet" {...edPage('accueil.pourquoi_titre')}>{txt(p.pourquoi_titre, lang)}</h2>
    <div class="prose pourquoi__texte" set:html={txtHtml(p.pourquoi_texte, lang)} {...edPage('accueil.pourquoi_texte', true)} />
  </div>
</section>

<section class="section section--marine rdv">
  <div class="enveloppe rdv__grille">
    <h2 class="titre-section">{t(lang, 'accueil.rdv_titre')}</h2>
    <div class="rdv__coordonnees">
      <address>
        {s.adresse.rue}<br />
        {`${s.adresse.code_postal} ${s.adresse.ville}`}
      </address>
      <a class="rdv__tel" href={`tel:${s.telephone.lien}`}>{s.telephone.affiche}</a>
      <a href={`mailto:${s.courriel}`}>{s.courriel}</a>
      {
        urlContact && (
          <a class="bouton bouton--or" href={urlContact}>
            {t(lang, 'accueil.rendez_vous')}
            <Icone nom="fleche" />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  /* --- Hero ---------------------------------------------------------------
     Marineblau ueber die ganze Breite: links Titel, Satz und Termin,
     rechts das Foto des Salons, randlos bis an die Kante. */
  .hero {
    display: grid;
    background: var(--color-marine);
    color: var(--color-marine-texte);
  }
  .hero__texte {
    padding: clamp(3.5rem, 2rem + 6vw, 7rem) var(--gouttiere) clamp(3rem, 2rem + 4vw, 5rem);
    animation: hero-entree 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .hero h1 {
    font-size: var(--text-affiche);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--color-blanc);
    max-width: 12ch;
  }
  .hero__intro {
    margin-top: 2rem;
    max-width: 48ch;
    font-size: var(--text-chapeau);
    line-height: 1.6;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.75rem;
  }
  .hero__tel {
    display: inline-flex;
    flex-direction: column;
    color: var(--color-blanc);
    font-family: var(--font-titre);
    font-size: 1.375rem;
    text-decoration: none;
    line-height: 1.2;
  }
  .hero__tel span {
    font-family: var(--font-texte);
    font-size: 0.8125rem;
    color: var(--color-marine-texte);
  }
  .hero__tel:hover {
    color: var(--color-or-clair);
  }
  .hero__image :global(picture),
  .hero__image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__image {
    aspect-ratio: 4 / 3;
  }
  .hero__preuves {
    display: grid;
    gap: 0.75rem 2.5rem;
    padding: 1.75rem var(--gouttiere);
    border-top: 1px solid color-mix(in srgb, var(--color-marine-texte) 22%, transparent);
    font-size: 0.875rem;
    color: var(--color-or-clair);
  }
  @media (min-width: 62rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      grid-template-rows: 1fr auto;
      min-height: min(88vh, 50rem);
    }
    .hero__texte {
      align-self: center;
      padding-left: max(var(--gouttiere), calc((100vw - var(--largeur)) / 2));
      padding-right: clamp(2rem, 5vw, 5rem);
    }
    .hero__image {
      grid-row: 1 / span 2;
      grid-column: 2;
      aspect-ratio: auto;
    }
    .hero__preuves {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
      padding-left: max(var(--gouttiere), calc((100vw - var(--largeur)) / 2));
    }
  }
  /* Nur Bewegung, keine Ausblendung: Der Text ist vom ersten Bild an
     lesbar, auch wenn der Browser Animationen anhaelt. */
  @keyframes hero-entree {
    from {
      transform: translateY(0.75rem);
    }
  }

  /* --- Die Kanzlei ---------------------------------------------------------- */
  .etude {
    display: grid;
    gap: 3.5rem;
  }
  .etude .prose {
    margin-top: 2rem;
  }
  .etude__portrait {
    margin: 0;
    max-width: 24rem;
  }
  .etude__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .etude__portrait figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--color-or);
    color: var(--color-gris);
    font-size: 0.9375rem;
  }
  .etude__nom {
    font-family: var(--font-titre);
    font-size: 1.375rem;
    color: var(--color-encre);
  }
  .etude__portrait .lien-fleche {
    justify-self: start;
    margin-top: 1rem;
  }
  @media (min-width: 62rem) {
    .etude {
      grid-template-columns: minmax(0, 1fr) 24rem;
      gap: clamp(4rem, 8vw, 8rem);
      align-items: start;
    }
    .etude__portrait {
      margin-top: 4.5rem;
    }
  }

  /* --- Taetigkeiten ---------------------------------------------------------- */
  .entete-section {
    display: grid;
    gap: 1.25rem 4rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 62rem) {
    .entete-section {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  /* --- Staerken ----------------------------------------------------------- */
  .atouts__liste {
    display: grid;
    gap: 2.5rem 3rem;
    margin-top: 3.5rem;
  }
  .atouts__liste li {
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-marine-texte) 30%, transparent);
  }
  .atouts__titre {
    font-family: var(--font-titre);
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-blanc);
  }
  @media (min-width: 48rem) {
    .atouts__liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 72rem) {
    .atouts__liste {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* --- Netzwerke ----------------------------------------------------------- */
  .specialiste {
    display: grid;
    gap: 3.5rem;
  }
  .specialiste .prose {
    margin-top: 2rem;
  }
  .reseaux h3 {
    font-family: var(--font-texte);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gris);
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-or);
  }
  .reseaux dl > div {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-trait);
  }
  .reseaux dt {
    font-family: var(--font-titre);
    font-size: 1.5rem;
    color: var(--color-marine);
  }
  .reseaux dd {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-gris);
  }
  @media (min-width: 62rem) {
    .specialiste {
      grid-template-columns: minmax(0, 1fr) 22rem;
      gap: clamp(4rem, 8vw, 8rem);
    }
    .reseaux {
      margin-top: 4.5rem;
    }
  }

  /* --- Dossiers und Konferenzen --------------------------------------------- */
  .publications {
    display: grid;
    gap: 4.5rem;
  }
  .publications .registre {
    margin-top: 2.5rem;
  }
  .publications .chapeau {
    margin-top: 1.25rem;
  }
  .publications__tous {
    margin-top: 2rem;
  }
  .publications__conf .registre__titre {
    font-size: 1.1875rem;
  }
  .publications__conf .etiquettes {
    grid-column: 1;
  }
  @media (min-width: 62rem) {
    .publications {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  /* --- Pourquoi ------------------------------------------------------------- */
  .pourquoi__texte {
    max-width: none;
    margin-top: 2.5rem;
  }
  @media (min-width: 62rem) {
    .pourquoi__texte {
      columns: 2;
      column-gap: clamp(3rem, 6vw, 6rem);
    }
    .pourquoi__texte :global(p) {
      break-inside: avoid;
    }
  }

  /* --- Termin --------------------------------------------------------------- */
  .rdv__grille {
    display: grid;
    gap: 2.5rem 6rem;
  }
  .rdv__coordonnees {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    font-size: 1.0625rem;
  }
  .rdv__coordonnees address {
    font-style: normal;
    line-height: 1.6;
    color: var(--color-blanc);
  }
  .rdv__coordonnees a {
    text-decoration: none;
  }
  .rdv__coordonnees a:not(.bouton):hover {
    color: var(--color-blanc);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .rdv__tel {
    margin-top: 0.75rem;
    font-family: var(--font-titre);
    font-size: 1.75rem;
    color: var(--color-or-clair);
  }
  .rdv .bouton {
    margin-top: 1.5rem;
  }
  @media (min-width: 62rem) {
    .rdv__grille {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
