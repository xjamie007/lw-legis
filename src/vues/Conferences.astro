---
/**
 * src/vues/Conferences.astro — Die Konferenzunterlagen von Me Lorang.
 *
 * Jede Unterlage mit Thema, Dateigroesse und Download. Die Unterlagen sind
 * franzoesisch; auf der englischen Seite steht das dabei. Eine Konferenz,
 * die auf ein Dossier statt auf ein PDF verweist, fuehrt dorthin; eine mit
 * Veranstaltungsseite verlinkt diese.
 */
import type { Lang } from '../lib/langs';
import { txt, txtOuFrancais } from '../lib/langs';
import { t, formaterTaille } from '../lib/i18n';
import { conferences, contenu, dossierParId, themeParId, themesDe } from '../lib/content';
import { adresse, type Route } from '../lib/pages';
import { ed, edPage } from '../lib/edition';
import { prefixer } from '../lib/base';
import Tete from '../components/Tete.astro';
import Icone from '../components/Icone.astro';

interface Props {
  lang: Lang;
  route: Route;
}
const { lang, route } = Astro.props;
const toutes = conferences();
const themes = themesDe(toutes, lang);

const mois = (iso: string) =>
  new Intl.DateTimeFormat(lang === 'fr' ? 'fr-LU' : 'en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
    new Date(iso),
  );

const entrees = toutes.map((c) => {
  const dossier = dossierParId(c.dossier, lang);
  const lien = c.pdf
    ? { href: prefixer(c.pdf.chemin), libelle: t(lang, 'conferences.telecharger'), icone: 'telecharger' as const, download: true, extra: `PDF · ${formaterTaille(c.pdf.octets, lang)}` }
    : dossier
      ? { href: adresse(`dossier:${dossier.id}`, lang)!, libelle: t(lang, 'conferences.lire'), icone: 'fleche' as const, download: false, extra: null }
      : c.lien_externe
        ? { href: c.lien_externe, libelle: t(lang, 'conferences.evenement'), icone: 'externe' as const, download: false, extra: null }
        : null;
  return { c, lien, titre: txtOuFrancais(c.titre, lang), resume: txtOuFrancais(c.resume, lang) };
});
---

<Tete
  lang={lang}
  fil={route.fil}
  titre={route.nom}
  chapeau={txt(contenu.pages.conferences.intro, lang)}
  edTitre={edPage('conferences.titre')}
  edChapeau={edPage('conferences.intro')}
/>

<section class="section">
  <div class="enveloppe">
    {
      themes.length > 1 && (
        <div class="filtres" data-filtres hidden role="group" aria-label={t(lang, 'conferences.filtrer')}>
          <button type="button" aria-pressed="true" data-theme="">
            {t(lang, 'conferences.tous')}
          </button>
          {themes.map((th) => (
            <button type="button" aria-pressed="false" data-theme={th.id}>
              {txt(th.etiquette, lang)}
            </button>
          ))}
        </div>
      )
    }
    <ol class="conferences" data-liste>
      {
        entrees.map(({ c, lien, titre, resume }) => (
          <li class="conference" data-themes={c.themes.join(' ')}>
            <div class="conference__texte">
              <h2 lang={titre.lang !== lang ? titre.lang : undefined} {...ed('publications', c.id, 'titre')}>
                {titre.valeur}
              </h2>
              {resume.valeur && <p lang={resume.lang !== lang ? resume.lang : undefined}>{resume.valeur}</p>}
              <span class="etiquettes">
                {c.date_publication && <span>{mois(c.date_publication)}</span>}
                {c.themes.map((th) => themeParId(th)).filter(Boolean).map((th) => <span>{txt(th!.etiquette, lang)}</span>)}
                {titre.lang !== lang && <span>{t(lang, 'conferences.en_francais')}</span>}
              </span>
            </div>
            {lien && (
              <a
                class="conference__lien"
                href={lien.href}
                download={lien.download || undefined}
                rel={lien.icone === 'externe' ? 'noopener' : undefined}
              >
                <Icone nom={lien.icone} />
                <span>
                  {lien.libelle}
                  {lien.extra && <small>{lien.extra}</small>}
                </span>
              </a>
            )}
          </li>
        ))
      }
    </ol>
    <p class="conferences__vide" data-vide hidden>{t(lang, 'conferences.aucune')}</p>
  </div>
</section>

<script>
  import '../scripts/filtres.ts';
</script>

<style>
  .filtres {
    margin-bottom: 2.5rem;
  }
  .conferences {
    border-top: 1px solid var(--color-trait);
  }
  .conference {
    display: grid;
    gap: 1rem 3rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--color-trait);
  }
  .conference h2 {
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .conference p {
    margin-top: 0.4rem;
    color: var(--color-gris);
    font-size: 0.9688rem;
    max-width: 62ch;
  }
  .conference .etiquettes {
    margin-top: 0.75rem;
  }
  .conference__lien {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.6rem;
    justify-self: start;
    color: var(--color-marine);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .conference__lien :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    color: var(--color-or);
  }
  .conference__lien small {
    display: block;
    font-weight: 400;
    color: var(--color-gris);
    font-size: 0.8125rem;
  }
  .conference__lien:hover span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .conferences__vide {
    padding-top: 2rem;
    color: var(--color-gris);
  }
  @media (min-width: 56rem) {
    .conference {
      grid-template-columns: minmax(0, 1fr) 14rem;
      align-items: start;
    }
  }
</style>
