---
/**
 * src/vues/Contact.astro — Kontakt.
 *
 * Links die Angaben der Kanzlei mit drei praktischen Wegen: anrufen,
 * Wegbeschreibung (OpenStreetMap, ohne eingebettete Karte und damit ohne
 * Datenuebertragung an Dritte beim Seitenaufruf) und „In Kontakte
 * aufnehmen“ als vCard. Rechts das Formular.
 */
import type { Lang } from '../lib/langs';
import { t } from '../lib/i18n';
import { contenu } from '../lib/content';
import type { Route } from '../lib/pages';
import { edPage } from '../lib/edition';
import { prefixer } from '../lib/base';
import Tete from '../components/Tete.astro';
import Icone from '../components/Icone.astro';
import Formulaire from '../components/Formulaire.astro';

interface Props {
  lang: Lang;
  route: Route;
}
const { lang, route } = Astro.props;
const s = contenu.settings;
const itineraire = `https://www.openstreetmap.org/search?query=${encodeURIComponent(s.adresse.une_ligne)}`;
---

<Tete lang={lang} fil={route.fil} titre={route.nom} edTitre={edPage('contact.titre')} />

<section class="section">
  <div class="enveloppe contact">
    <div class="coordonnees">
      <p class="coordonnees__nom">{s.nom}</p>
      <dl>
        <div>
          <dt>{t(lang, 'contact.adresse')}</dt>
          <dd>
            {s.adresse.rue}<br />
            {`${s.adresse.code_postal} ${s.adresse.ville}`}
          </dd>
        </div>
        <div>
          <dt>{t(lang, 'contact.postale')}</dt>
          <dd>{s.postfach.une_ligne}</dd>
        </div>
        <div>
          <dt>{t(lang, 'contact.telephone')}</dt>
          <dd><a class="coordonnees__tel" href={`tel:${s.telephone.lien}`}>{s.telephone.affiche}</a></dd>
        </div>
        <div>
          <dt>{t(lang, 'contact.courriel')}</dt>
          <dd><a href={`mailto:${s.courriel}`}>{s.courriel}</a></dd>
        </div>
      </dl>
      <ul class="coordonnees__actions">
        <li>
          <a href={itineraire} rel="noopener"><Icone nom="lieu" />{t(lang, 'contact.itineraire')}</a>
        </li>
        <li>
          <a href={prefixer('/lw-legis.vcf')} download="LW-LEGIS.vcf"><Icone nom="carte" />{t(lang, 'contact.vcard')}</a>
        </li>
      </ul>
    </div>

    <div class="contact__formulaire">
      <h2>{t(lang, 'contact.ecrire')}</h2>
      <Formulaire lang={lang} />
    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: 4rem;
  }
  .coordonnees__nom {
    font-family: var(--font-titre);
    font-size: 1.625rem;
    color: var(--color-encre);
    padding-bottom: 1.25rem;
    border-bottom: 2px solid var(--color-or);
  }
  .coordonnees dl > div {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--color-trait);
  }
  .coordonnees dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gris);
  }
  .coordonnees dd {
    margin-top: 0.3rem;
    color: var(--color-encre);
  }
  .coordonnees dd a {
    text-decoration-color: var(--color-or);
    text-underline-offset: 3px;
  }
  .coordonnees__tel {
    font-family: var(--font-titre);
    font-size: 1.5rem;
    text-decoration: none;
  }
  .coordonnees__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .coordonnees__actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-marine);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .coordonnees__actions a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .coordonnees__actions :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-or);
  }
  .contact__formulaire h2 {
    font-size: var(--text-h2);
    font-weight: 300;
    margin-bottom: 2rem;
  }
  @media (min-width: 62rem) {
    .contact {
      grid-template-columns: 22rem minmax(0, 1fr);
      gap: clamp(4rem, 8vw, 8rem);
    }
  }
</style>
