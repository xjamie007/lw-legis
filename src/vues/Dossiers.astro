---
/**
 * src/vues/Dossiers.astro — Dossiers thématiques: Uebersicht und Text.
 *
 * Die Uebersicht laesst sich nach Thema filtern. Ohne JavaScript stehen
 * einfach alle Dossiers da; die Filterknoepfe erscheinen erst mit Skript.
 * Der Text hat Lesezeit, Drucken und die Konferenzen zum selben Thema.
 */
import type { Lang } from '../lib/langs';
import { txt, txtOuFrancais, txtHtml } from '../lib/langs';
import { t, formaterTaille } from '../lib/i18n';
import { conferences, contenu, dossiers, mots, themeParId, themesDe, type Publication } from '../lib/content';
import { adresse, type Route } from '../lib/pages';
import { ed, edPage } from '../lib/edition';
import { prefixer } from '../lib/base';
import Tete from '../components/Tete.astro';
import Icone from '../components/Icone.astro';

interface Props {
  lang: Lang;
  route: Route;
  dossier?: Publication;
}
const { lang, route, dossier } = Astro.props;
const tous = dossiers(lang);
const themes = themesDe(tous, lang);

const minutes = dossier ? Math.max(1, Math.round(mots(txt(dossier.corps, lang)) / 220)) : 0;
const liees = dossier
  ? conferences()
      .filter((c) => c.pdf && c.themes.some((th) => dossier.themes.includes(th)))
      .slice(0, 5)
  : [];
---

{
  !dossier && (
    <>
      <Tete
        lang={lang}
        fil={route.fil}
        titre={route.nom}
        chapeau={txt(contenu.pages.dossiers.intro, lang)}
        edTitre={edPage('dossiers.titre')}
        edChapeau={edPage('dossiers.intro')}
      />
      <section class="section">
        <div class="enveloppe">
          {themes.length > 1 && (
            <div class="filtres" data-filtres hidden role="group" aria-label={t(lang, 'conferences.filtrer')}>
              <button type="button" aria-pressed="true" data-theme="">
                {t(lang, 'conferences.tous')}
              </button>
              {themes.map((th) => (
                <button type="button" aria-pressed="false" data-theme={th.id}>
                  {txt(th.etiquette, lang)}
                </button>
              ))}
            </div>
          )}
          <ul class="registre liste-filtree" data-liste>
            {tous.map((d) => (
              <li class="registre__ligne" data-themes={d.themes.join(' ')}>
                <a class="registre__lien" href={adresse(`dossier:${d.id}`, lang)}>
                  <span class="registre__titre" {...ed('publications', d.id, 'titre')}>
                    {txt(d.titre, lang)}
                  </span>
                  <span class="registre__texte">{txt(d.resume, lang)}</span>
                  <span class="etiquettes">
                    {d.themes.map((th) => themeParId(th)).filter(Boolean).map((th) => <span>{txt(th!.etiquette, lang)}</span>)}
                  </span>
                  <Icone nom="fleche" class="registre__fleche" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </>
  )
}

{
  dossier && (
    <>
      <Tete
        lang={lang}
        fil={route.fil}
        titre={route.nom}
        chapeau={txt(dossier.resume, lang)}
        edTitre={ed('publications', dossier.id, 'titre')}
        edChapeau={ed('publications', dossier.id, 'resume')}
      >
        <div class="dossier__meta">
          <span class="etiquettes">
            {dossier.themes.map((th) => themeParId(th)).filter(Boolean).map((th) => <span>{txt(th!.etiquette, lang)}</span>)}
            <span>
              {minutes} {t(lang, 'dossier.lecture')}
            </span>
          </span>
          <button type="button" class="dossier__imprimer sans-impression" data-imprimer hidden>
            <Icone nom="imprimer" />
            {t(lang, 'dossier.imprimer')}
          </button>
        </div>
      </Tete>
      <section class="section">
        <div class="enveloppe avec-aside">
          <article class="prose" set:html={txtHtml(dossier.corps, lang)} {...ed('publications', dossier.id, 'corps', true)} />
          <aside class="sans-impression">
            {liees.length > 0 && (
              <nav class="liste-aside liste-aside--premiere" aria-labelledby="conf-liees">
                <h2 id="conf-liees">{t(lang, 'dossier.conferences_liees')}</h2>
                {liees.map((c) => {
                  const titre = txtOuFrancais(c.titre, lang);
                  return (
                    <a href={prefixer(c.pdf!.chemin)} download lang={titre.lang !== lang ? titre.lang : undefined}>
                      {titre.valeur}
                      <small>PDF · {formaterTaille(c.pdf!.octets, lang)}</small>
                    </a>
                  );
                })}
              </nav>
            )}
            <nav class="liste-aside" aria-labelledby="autres-dossiers">
              <h2 id="autres-dossiers">{t(lang, 'dossier.tous')}</h2>
              {tous.map((d) => (
                <a href={adresse(`dossier:${d.id}`, lang)} aria-current={d.id === dossier.id ? 'page' : undefined}>
                  {txt(d.titre, lang)}
                </a>
              ))}
            </nav>
          </aside>
        </div>
      </section>
    </>
  )
}

<script>
  import '../scripts/filtres.ts';
</script>

<style>
  .filtres {
    margin-bottom: 2.5rem;
  }
  .dossier__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-trait);
  }
  .dossier__imprimer {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0;
    background: none;
    border: 0;
    color: var(--color-marine);
    font-weight: 600;
    font-size: 0.9063rem;
    cursor: pointer;
  }
  .dossier__imprimer :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .dossier__imprimer:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .liste-aside--premiere {
    margin-top: 0;
  }
  .liste-aside small {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-gris);
    font-size: 0.8125rem;
  }
  .registre .etiquettes {
    grid-column: 1;
    margin-top: 0.5rem;
  }
</style>
