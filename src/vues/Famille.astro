---
/**
 * src/vues/Famille.astro — Ein Taetigkeitsgebiet im Einzelnen.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import { documentsParThemes, type Famille } from '../lib/content';
import { seg } from '../lib/routes';
import Marge from '../components/Marge.astro';
import Formulaire from '../components/Formulaire.astro';
import { ed, edFamille } from '../lib/edition';

interface Props {
  lang: Lang;
  famille: Famille;
}
const { lang, famille } = Astro.props;

/** Themen dieses Gebiets, fuer die Verbindung zur Bibliothek. */
const THEMES_PAR_FAMILLE: Record<string, string[]> = {
  'immobilier-patrimoine': ['immobilier'],
  'societes-fiscalite': ['societes', 'fiscalite', 'banque'],
  successions: ['successions'],
  'creances-droits': ['recouvrement', 'propriete-intellectuelle', 'contentieux', 'assurance'],
};
const documents = documentsParThemes(THEMES_PAR_FAMILLE[famille.id] ?? [], lang);
const sPub = seg('publications', lang);
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2" data-revele="titre" {...edFamille(famille.id, 'terme')}>{txt(famille.terme, lang)}</h1>
      <p class="chapeau" data-revele="texte" {...edFamille(famille.id, 'definition')}>{txt(famille.definition, lang)}</p>
      <p class="corps" {...edFamille(famille.id, 'texte')}>{txt(famille.texte, lang)}</p>
      <Marge
        terme={txt(famille.marge.terme, lang)}
        edTerme={edFamille(famille.id, 'marge.terme')}
        edTexte={edFamille(famille.id, 'marge.texte')}
      >
        {txt(famille.marge.texte, lang)}
      </Marge>

      <h2 class="titre-3 rubrique">{t(lang, 'services.dans_ce_domaine')}</h2>
      <ul class="liste matieres" data-revele="liste">
        {famille.matieres.map((m, i) => <li {...edFamille(famille.id, `matieres.${i}`)}>{txt(m, lang)}</li>)}
      </ul>

      {
        documents.length > 0 && sPub && (
          <>
            <h2 class="titre-3 rubrique">{t(lang, 'situation.documents')}</h2>
            <ul class="liste">
              {documents.map((d) => (
                <li>
                  <a href={`/${lang}/${sPub}/${txt(d.slug, lang)}/`} {...ed('publications', d.id, 'titre')}>{txt(d.titre, lang)}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>
  </div>
</article>

<section class="section section--craie" aria-labelledby="titre-contact-famille">
  <div class="enveloppe">
    <div class="colonne">
      <h2 class="titre-2" id="titre-contact-famille">{t(lang, 'formulaire.titre')}</h2>
      <Formulaire lang={lang} niveau={3} id="formulaire-famille" />
    </div>
  </div>
</section>

<style>
  .rubrique {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .matieres {
    color: var(--color-pierre);
  }
</style>
