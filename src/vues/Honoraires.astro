---
/**
 * src/vues/Honoraires.astro — Honorare.
 *
 * Die einzige Nummerierung der ganzen Seite steht hier: der Ablauf einer
 * Anfrage ist wirklich eine Reihenfolge. Sonst nirgends.
 *
 * Die Betraege fehlen und bleiben sichtbar offen. Erfundene Zahlen waeren
 * hier besonders schaedlich, weil diese Sektion die Antwort auf die
 * einzige ernsthafte oeffentliche Kritik an der Kanzlei ist.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import { contenu } from '../lib/content';
import Lacune from '../components/Lacune.astro';
import Formulaire from '../components/Formulaire.astro';
import { edPage } from '../lib/edition';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = contenu.pages.honoraires;
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2" data-revele="titre" {...edPage('honoraires.titre')}>{txt(page.titre, lang)}</h1>
      <p class="chapeau" data-revele="texte" {...edPage('honoraires.chapeau')}>{txt(page.chapeau, lang)}</p>

      <dl class="postes" data-revele="definitions">
        {
          page.postes.map((p: { id: string; ouvert: string }) => (
            <>
              <dt>{t(lang, `honoraires.${p.id}` as never)}</dt>
              <dd>
                <Lacune id={p.ouvert} lang={lang} />
              </dd>
            </>
          ))
        }
      </dl>

      <p class="corps">{t(lang, 'honoraires.convention')}</p>
      <p class="corps" {...edPage('honoraires.note_transparence')}>{txt(page.note_transparence, lang)}</p>

      <h2 class="titre-3 rubrique" {...edPage('honoraires.deroulement.titre')}>{txt(page.deroulement.titre, lang)}</h2>
      <ol class="liste liste--nombres etapes" data-revele="liste">
        {page.deroulement.etapes.map((e: Record<string, string>, i: number) => (
          <li {...edPage(`honoraires.deroulement.etapes.${i}`)}>{txt(e, lang)}</li>
        ))}
      </ol>
    </div>
  </div>
</article>

<section class="section section--craie" aria-labelledby="titre-contact-honoraires">
  <div class="enveloppe">
    <div class="colonne">
      <h2 class="titre-2" id="titre-contact-honoraires">{t(lang, 'formulaire.titre')}</h2>
      <Formulaire lang={lang} niveau={3} id="formulaire-honoraires" />
    </div>
  </div>
</section>

<style>
  .rubrique {
    margin-top: 2.75rem;
    margin-bottom: 0.9rem;
  }
  .postes {
    margin: 2rem 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem 1.5rem;
    max-width: var(--mesure);
  }
  .postes dt {
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    font-weight: 500;
  }
  .postes dd {
    margin: 0 0 1rem;
  }
  @media (min-width: 40rem) {
    .postes {
      grid-template-columns: minmax(10rem, 14rem) 1fr;
    }
    .postes dd {
      margin-bottom: 0.5rem;
    }
  }
  .etapes li {
    padding-left: 0.3rem;
  }
</style>
