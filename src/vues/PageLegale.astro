---
/**
 * src/vues/PageLegale.astro — Mentions légales, protection des données,
 * cookies, conditions générales. Wortlaut der alten Seite (nur
 * Franzoesisch, bis auf die Geschaeftsbedingungen).
 */
import type { Lang } from '../lib/langs';
import { txt, txtHtml } from '../lib/langs';
import { contenu } from '../lib/content';
import type { Route } from '../lib/pages';
import { ed } from '../lib/edition';
import Tete from '../components/Tete.astro';

interface Props {
  lang: Lang;
  route: Route;
  quelle: 'mentions' | 'donnees' | 'cookies' | 'conditions';
}
const { lang, route, quelle } = Astro.props;
const page = contenu.legal[quelle];
---

<Tete lang={lang} fil={route.fil} titre={route.nom} edTitre={ed('legal_pages', quelle, 'titre')} />

<section class="section">
  <div class="enveloppe">
    <div class="prose" set:html={txtHtml(page.corps, lang)} {...ed('legal_pages', quelle, 'corps', true)} />
  </div>
</section>
