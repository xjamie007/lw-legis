---
/**
 * src/vues/Publications.astro — Die Bibliothek.
 *
 * Gefiltert wird ueber echte Adressen (/…/publications/theme/immobilier/),
 * damit die Filterung ohne JavaScript funktioniert. JavaScript verfeinert
 * hoechstens, es traegt nichts Notwendiges.
 *
 * Solange kein Dokument freigegeben ist, steht hier keine leere Liste,
 * sondern der Hinweis, dass die Texte nach und nach online gehen — und
 * die offene Stelle, die sagt, was dafuer noch fehlt.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t, formaterDate } from '../lib/i18n';
import {
  contenu,
  publicationsPubliees,
  themesAvecDocuments,
  type Publication,
  type Theme,
} from '../lib/content';
import { seg } from '../lib/routes';
import Lacune from '../components/Lacune.astro';
import { ed, edPage } from '../lib/edition';

interface Props {
  lang: Lang;
  /** Gesetzt auf einer Themen-Filterseite. */
  theme?: Theme | null;
}
const { lang, theme = null } = Astro.props;

const page = contenu.pages.publications;
const sPub = seg('publications', lang);
const sTheme = seg('theme', lang);
const base = sPub ? `/${lang}/${sPub}/` : null;

const tous = publicationsPubliees(lang);
const documents: Publication[] = theme ? tous.filter((p) => p.themes.includes(theme.id)) : tous;
const themes = themesAvecDocuments(lang);

const etiquetteType = (p: Publication) =>
  p.type === 'dossier' ? t(lang, 'publications.type_dossier') : t(lang, 'publications.type_conference');
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2" {...(theme ? ed('publication_tags', theme.id, 'etiquette') : edPage('publications.titre'))}>
        {theme ? txt(theme.etiquette, lang) : txt(page.titre, lang)}
      </h1>
      <p class="chapeau discret" data-revele="texte" {...edPage('publications.chapeau')}>{txt(page.chapeau, lang)}</p>
    </div>
  </div>

  {/* --- Filter: echte Links, keine Skripte --------------------------- */}
  {
    themes.length > 0 && base && sTheme && (
      <div class="enveloppe">
        <nav class="filtres" aria-label={t(lang, 'publications.filtre_theme')}>
          <p class="filtres__titre">{t(lang, 'publications.filtre_theme')}</p>
          <ul class="filtres__liste">
            <li>
              <a
                href={base}
                class:list={['filtres__lien', { 'filtres__lien--actif': !theme }]}
                aria-current={!theme ? 'page' : undefined}
              >
                {t(lang, 'publications.tous')}
              </a>
            </li>
            {themes.map((th) => (
              <li>
                <a
                  href={`${base}${sTheme}/${txt(th.slug, lang)}/`}
                  class:list={[
                    'filtres__lien',
                    { 'filtres__lien--actif': theme?.id === th.id },
                  ]}
                  aria-current={theme?.id === th.id ? 'page' : undefined}
                >
                  {txt(th.etiquette, lang)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    )
  }

  <div class="enveloppe">
    <div class="colonne">
      {
        documents.length > 0 ? (
          <ul class="bibliotheque" data-revele="liste">
            {documents.map((p) => (
              <li class="bibliotheque__element rang">
                <a class="bibliotheque__lien" href={`${base}${txt(p.slug, lang)}/`} {...ed('publications', p.id, 'titre')}>
                  {txt(p.titre, lang)}
                </a>
                <p class="bibliotheque__resume" {...ed('publications', p.id, 'resume')}>{txt(p.resume, lang)}</p>
                <p class="bibliotheque__meta">
                  <span>{etiquetteType(p)}</span>
                  {p.etat_du_droit && (
                    <span>
                      {t(lang, 'publications.etat_du_droit')}{' '}
                      {formaterDate(p.etat_du_droit, lang)}
                    </span>
                  )}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <div class="corps corps--flux">
            <p>{t(lang, 'publications.en_preparation')}</p>
            <p class="note">
              <Lacune id="documents_texte" lang={lang} />{' '}
              <Lacune id="documents_rechtsstand" lang={lang} />
            </p>
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .filtres {
    margin-top: 2.5rem;
  }
  .filtres__titre {
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-pierre);
    margin-bottom: 0.6rem;
  }
  .filtres__liste {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .filtres__lien {
    display: inline-block;
    min-height: 2.25rem;
    padding-block: 0.5rem;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
    color: var(--color-frontiere);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
  }
  .filtres__lien:hover {
    color: var(--color-frontiere-tief);
    border-bottom-color: var(--color-laiton);
  }
  .filtres__lien--actif {
    color: var(--color-encre);
    border-bottom-color: var(--color-laiton);
  }

  .bibliotheque {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .bibliotheque__element {
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-pierre) 20%, transparent);
  }
  .bibliotheque__element:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-pierre) 20%, transparent);
  }
  .bibliotheque__lien {
    font-family: var(--font-lecture);
    font-size: var(--text-h3);
    font-weight: 600;
    color: var(--color-encre);
    text-decoration: none;
  }
  .bibliotheque__lien:hover {
    color: var(--color-frontiere-tief);
    text-decoration: underline;
  }
  .bibliotheque__resume {
    margin-top: 0.5rem;
    color: var(--color-pierre);
  }
  .bibliotheque__meta {
    margin-top: 0.6rem;
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-pierre);
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.5rem;
  }
</style>
