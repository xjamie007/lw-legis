---
/**
 * src/vues/Recu.astro — Bestaetigung nach dem Absenden des Formulars.
 */
import type { Lang } from '../lib/langs';
import { t } from '../lib/i18n';
import { contenu } from '../lib/content';
import type { Route } from '../lib/pages';
import { urlAccueil } from '../lib/routes';
import Tete from '../components/Tete.astro';

interface Props {
  lang: Lang;
  route: Route;
}
const { lang, route } = Astro.props;
const s = contenu.settings;
import { edLibelle } from '../lib/edition';
import S from '../components/S.astro';
---

<Tete lang={lang} fil={route.fil} titre={route.nom} chapeau={t(lang, 'recu.texte')} edChapeau={edLibelle('recu.texte')} />

<section class="section">
  <div class="enveloppe recu">
    <p><S k="nom" />, <S k="adresse.rue" />, <S k="adresse.code_postal" /> <S k="adresse.ville" /></p>
    <p><a href={`tel:${s.telephone.lien}`}><S k="telephone.affiche" /></a> · <a href={`mailto:${s.courriel}`}><S k="courriel" /></a></p>
    <a class="bouton bouton--contour" href={urlAccueil(lang)} {...edLibelle('recu.retour')}>{t(lang, 'recu.retour')}</a>
  </div>
</section>

<style>
  .recu p + p {
    margin-top: 0.4rem;
  }
  .recu a:not(.bouton) {
    text-decoration-color: var(--color-or);
    text-underline-offset: 3px;
  }
  .recu .bouton {
    margin-top: 2.5rem;
  }
</style>
