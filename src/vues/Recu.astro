---
/**
 * src/vues/Recu.astro — Bestaetigung nach dem Absenden.
 *
 * Sagt, was jetzt passiert, an wen die Anfrage ging und bis wann eine
 * Antwort kommt. Die Frist steht bewusst offen: sie muss stimmen, weil
 * sie ein Versprechen ist — und weil der einzige ernsthafte oeffentliche
 * Vorwurf gegen die Kanzlei lautet, auf E-Mails nicht geantwortet zu haben.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import { contenu } from '../lib/content';
import Lacune from '../components/Lacune.astro';
import { edPage } from '../lib/edition';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = contenu.pages.recu;
const s = contenu.settings;
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2" {...edPage('recu.titre')}>{txt(page.titre, lang)}</h1>
      <p class="chapeau" {...edPage('recu.texte')}>{txt(page.texte, lang)}</p>

      <h2 class="titre-3 rubrique">{t(lang, 'formulaire.recu_quoi')}</h2>
      <ul class="liste">
        <li>
          {s.nom}, {s.adresse.une_ligne}
        </li>
        <li>
          <Lacune id="delai_reponse" lang={lang} />
        </li>
        <li {...edPage('recu.ensuite')}>{txt(page.ensuite, lang)}</li>
      </ul>

      <p class="apres">
        <a class="bouton bouton--contour" href={`tel:${s.telephone.central_lien}`}>
          {s.telephone.central}
        </a>
      </p>
    </div>
  </div>
</article>

<style>
  .rubrique {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
  }
  .apres {
    margin-top: 2.25rem;
  }
</style>
