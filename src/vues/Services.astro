---
/**
 * src/vues/Services.astro — Uebersicht der Taetigkeitsgebiete.
 *
 * Eine Definitionsliste, kein Kartenraster: kein Rahmen, kein Radius,
 * kein Schatten, keine gleich grossen Kacheln.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import { contenu, familles } from '../lib/content';
import { seg } from '../lib/routes';
import Marge from '../components/Marge.astro';
import { edFamille, edPage } from '../lib/edition';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const page = contenu.pages.services;
const nos = familles(lang);
const sSrv = seg('services', lang);
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2" data-revele="titre" {...edPage('services.titre')}>{txt(page.titre, lang)}</h1>
      <p class="chapeau discret" data-revele="texte" {...edPage('services.chapeau')}>{txt(page.chapeau, lang)}</p>

      <dl class="definitions" data-revele="definitions">
        {
          nos.map((f) => (
            <>
              <dt class="definitions__terme">
                <a href={sSrv ? `/${lang}/${sSrv}/${txt(f.slug, lang)}/` : '#'} {...edFamille(f.id, 'terme')}>
                  {txt(f.terme, lang)}
                </a>
              </dt>
              <dd class="definitions__texte">
                <p class="definitions__definition" {...edFamille(f.id, 'definition')}>{txt(f.definition, lang)}</p>
                <p {...edFamille(f.id, 'texte')}>{txt(f.texte, lang)}</p>
              </dd>
            </>
          ))
        }
      </dl>

      <Marge
        terme={txt(nos[1]?.marge.terme, lang)}
        edTerme={edFamille(nos[1]?.id, 'marge.terme')}
        edTexte={edFamille(nos[1]?.id, 'marge.texte')}
      >
        {txt(nos[1]?.marge.texte, lang)}
      </Marge>
    </div>
  </div>
</article>

<style>
  .definitions__terme a {
    color: var(--color-encre);
    text-decoration: none;
    border-bottom: 1.5px solid var(--color-laiton);
  }
  .definitions__terme a:hover {
    color: var(--color-frontiere-tief);
  }
  .definitions__definition {
    color: var(--color-pierre);
    margin-bottom: 0.4rem;
  }
</style>
