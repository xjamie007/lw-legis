---
/**
 * src/vues/SituationPays.astro — Ein Land, seine sieben Vorhaben.
 *
 * Diese Seite ist der Zwischenschritt, der den Hero ohne JavaScript
 * bedienbar macht: der Landeseintrag im Popover verlinkt hierher.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import {
  contenu,
  familleParId,
  situationsPubliees,
  type OptionAxe,
} from '../lib/content';
import { seg } from '../lib/routes';

interface Props {
  lang: Lang;
  pays: OptionAxe;
  projets: OptionAxe[];
}
const { lang, pays, projets } = Astro.props;

const publiees = new Set(
  situationsPubliees(lang)
    .filter((s) => s.pays === pays.id)
    .map((s) => s.projet),
);

const sSit = seg('situations', lang);
const sSrv = seg('services', lang);
const base = sSit ? `/${lang}/${sSit}/` : null;

const phrase = {
  fr: (p: string, v: string) => `Vous êtes ${p} et vous souhaitez, au Luxembourg, ${v}.`,
  de: (p: string, v: string) => `Sie sind ${p} und möchten in Luxemburg ${v}.`,
  en: (p: string, v: string) => `You are ${p} and you want to ${v} in Luxembourg.`,
  lb: () => '',
}[lang];
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2">
        {t(lang, 'situation.intro_axe_pays')}: {txt(pays.etiquette, lang)}
      </h1>
      <p class="chapeau discret">{txt(contenu.pages.situations.chapeau, lang)}</p>

      <ul class="vorhaben" data-revele="liste">
        {
          projets.map((pr) => {
            const fertig = publiees.has(pr.id);
            const f = familleParId(contenu.projet_vers_famille[pr.id] ?? null);
            const href = fertig && base
              ? `${base}${txt(pays.slug, lang)}/${txt(pr.slug, lang)}/`
              : f && sSrv
                ? `/${lang}/${sSrv}/${txt(f.slug, lang)}/`
                : null;
            return (
              <li class="vorhaben__element rang">
                {href ? (
                  <a class="vorhaben__lien" href={href}>
                    <span class="vorhaben__phrase">
                      {phrase(txt(pays.dans_la_phrase, lang), txt(pr.dans_la_phrase, lang))}
                    </span>
                    {!fertig && f && (
                      <span class="vorhaben__note">
                        {t(lang, 'situation.vers_domaine')}: {txt(f.terme, lang)}
                      </span>
                    )}
                  </a>
                ) : (
                  <span class="vorhaben__phrase">{txt(pr.etiquette, lang)}</span>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</article>

<style>
  .vorhaben {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    max-width: var(--mesure);
  }
  .vorhaben__element {
    border-top: 1px solid color-mix(in srgb, var(--color-pierre) 20%, transparent);
  }
  .vorhaben__element:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--color-pierre) 20%, transparent);
  }
  .vorhaben__lien {
    display: block;
    padding-block: 1.05rem;
    text-decoration: none;
  }
  .vorhaben__phrase {
    display: block;
    font-family: var(--font-lecture);
    font-size: 1.1875rem;
    line-height: 1.4;
    color: var(--color-frontiere);
  }
  .vorhaben__lien:hover .vorhaben__phrase {
    color: var(--color-frontiere-tief);
    text-decoration: underline;
  }
  .vorhaben__note {
    display: block;
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-pierre);
    margin-top: 0.3rem;
  }
</style>
