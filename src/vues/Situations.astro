---
/**
 * src/vues/Situations.astro — Uebersicht der Situationsmatrix.
 *
 * Die vollstaendige Matrix als Liste echter Links: sechs Laender mal
 * sieben Vorhaben. Damit ist jede Konstellation ohne JavaScript und ohne
 * Popover erreichbar, und Suchmaschinen finden von hier aus jede
 * veroeffentlichte Seite.
 *
 * Noch nicht ausgearbeitete Konstellationen fuehren auf das zugehoerige
 * Taetigkeitsgebiet — nie auf eine leere Seite, nie auf 404.
 */
import type { Lang } from '../lib/langs';
import { txt } from '../lib/langs';
import { t } from '../lib/i18n';
import {
  contenu,
  familleParId,
  paysOptions,
  projetOptions,
  situationsPubliees,
} from '../lib/content';
import { seg } from '../lib/routes';
import { edPage } from '../lib/edition';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const page = contenu.pages.situations;
const pays = paysOptions(lang);
const projets = projetOptions(lang);
const publiees = new Set(situationsPubliees(lang).map((s) => `${s.pays}--${s.projet}`));

const sSit = seg('situations', lang);
const sSrv = seg('services', lang);
const base = sSit ? `/${lang}/${sSit}/` : null;

/** Adresse fuer eine Konstellation — echt, wenn fertig, sonst der Ersatz. */
function adresse(paysId: string, projetId: string) {
  const p = pays.find((x) => x.id === paysId)!;
  const pr = projets.find((x) => x.id === projetId)!;
  if (publiees.has(`${paysId}--${projetId}`) && base) {
    return { href: `${base}${txt(p.slug, lang)}/${txt(pr.slug, lang)}/`, fertig: true, nom: null };
  }
  const f = familleParId(contenu.projet_vers_famille[projetId] ?? null);
  return {
    href: f && sSrv ? `/${lang}/${sSrv}/${txt(f.slug, lang)}/` : null,
    fertig: false,
    nom: f ? txt(f.terme, lang) : null,
  };
}
---

<article class="section">
  <div class="enveloppe">
    <div class="colonne">
      <h1 class="titre-2" data-revele="titre" {...edPage('situations.titre')}>{txt(page.titre, lang)}</h1>
      <p class="chapeau discret" data-revele="texte" {...edPage('situations.chapeau')}>{txt(page.chapeau, lang)}</p>
      <p class="note" {...edPage('situations.note_etat')}>{txt(page.note_etat, lang)}</p>
    </div>
  </div>

  <div class="enveloppe matrice">
    {
      projets.map((pr) => (
        <section class="matrice__bloc" id={`projet-${pr.id}`} aria-labelledby={`t-${pr.id}`}>
          <h2 class="titre-3 matrice__titre" id={`t-${pr.id}`} data-revele="titre">
            {txt(pr.etiquette, lang)}
          </h2>
          <ul class="matrice__liste" data-revele="liste">
            {pays.map((p) => {
              const a = adresse(p.id, pr.id);
              return (
                <li class="matrice__element rang">
                  {a.href ? (
                    <a href={a.href} class:list={['matrice__lien', { 'matrice__lien--repli': !a.fertig }]}>
                      <span class="matrice__pays">{txt(p.etiquette, lang)}</span>
                      {!a.fertig && a.nom && (
                        <span class="matrice__note">
                          {t(lang, 'situation.vers_domaine')}: {a.nom}
                        </span>
                      )}
                    </a>
                  ) : (
                    <span class="matrice__pays">{txt(p.etiquette, lang)}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</article>

<style>
  .matrice {
    margin-top: var(--section-espace);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .matrice__bloc {
    scroll-margin-top: 6rem;
  }
  .matrice__titre {
    padding-bottom: 0.6rem;
    border-bottom: var(--trait);
  }
  .matrice__liste {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .matrice__element {
    border-bottom: 1px solid color-mix(in srgb, var(--color-pierre) 18%, transparent);
  }
  .matrice__lien {
    display: block;
    min-height: 2.75rem;
    padding-block: 0.7rem;
    text-decoration: none;
    color: var(--color-frontiere);
  }
  .matrice__lien:hover .matrice__pays {
    text-decoration: underline;
  }
  .matrice__lien--repli {
    color: var(--color-pierre);
  }
  .matrice__pays {
    display: block;
    font-family: var(--font-commande);
    font-size: var(--text-commande);
  }
  .matrice__note {
    display: block;
    font-family: var(--font-commande);
    font-size: var(--text-marge);
    color: var(--color-pierre);
    margin-top: 0.15rem;
  }
  @media (min-width: 50rem) {
    .matrice {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 3rem;
    }
  }
  @media (min-width: 75rem) {
    .matrice {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
